+
+// Isotope: the pieces of the login screen's look (src/greeter.rs, App::menu)
+// that the lock screen (src/locker.rs, App::menu) uses too, so both screens
+// stay one look.
+
+/// Glass: the theme's background colour, translucent, over the soft
+/// wallpaper, with a hairline edge. A pill or a circle.
+pub fn glass(theme: &cosmic::Theme, alpha: f32, focused: bool) -> widget::button::Style {
+    let cosmic = theme.cosmic();
+    let mut background: iced::Color = cosmic.background(theme.transparent).base.into();
+    background.a = alpha;
+    let mut border: iced::Color = cosmic.background(theme.transparent).on.into();
+    border.a = 0.14;
+    let on: iced::Color = cosmic.background(theme.transparent).on.into();
+    widget::button::Style {
+        background: Some(Background::Color(background)),
+        border_radius: 999.0.into(),
+        border_width: 1.0,
+        border_color: border,
+        outline_width: if focused { 2.0 } else { 0.0 },
+        outline_color: cosmic.accent_color().into(),
+        icon_color: Some(on),
+        text_color: Some(on),
+        ..Default::default()
+    }
+}
+
+pub fn glass_class() -> theme::Button {
+    theme::Button::Custom {
+        active: Box::new(|focused, theme| glass(theme, 0.38, focused)),
+        disabled: Box::new(|theme| glass(theme, 0.2, false)),
+        hovered: Box::new(|focused, theme| glass(theme, 0.55, focused)),
+        pressed: Box::new(|focused, theme| glass(theme, 0.7, focused)),
+    }
+}
+
+/// A round glass button with an icon.
+pub fn glass_button<'a, M: Clone + 'static>(icon: &'static str) -> widget::Button<'a, M> {
+    widget::button::custom(widget::icon::from_name(icon).size(20))
+        .padding(14.0)
+        .class(glass_class())
+}
+
+/// A round glass button with its label under it.
+pub fn glass_action<'a, M: Clone + 'static>(
+    button: impl Into<Element<'a, M>>,
+    label: String,
+) -> Element<'a, M> {
+    widget::column::with_capacity(2)
+        .spacing(6.0)
+        .align_x(Alignment::Center)
+        .push(button)
+        .push(widget::text::caption(label))
+        .width(Length::Fixed(96.0))
+        .into()
+}
+
+/// The small buttons of the top-right strip: flat until hovered.
+pub fn strip_button<'a, M: Clone + 'static>(content: Element<'a, M>) -> widget::Button<'a, M> {
+    widget::button::custom(content)
+        .padding([6.0, 10.0])
+        .class(theme::Button::Text)
+}
+
+/// Top left: the Isotope mark and wordmark. The mark has a version for light
+/// themes (ink shell, deep brand core), as on the day wallpaper, so it reads
+/// on the light soft wallpaper.
+pub fn brand<'a, M: Clone + 'static>() -> Element<'a, M> {
+    let mark_path = if cosmic::theme::is_dark() {
+        "/usr/share/isotope/greeter-mark.svg"
+    } else {
+        "/usr/share/isotope/greeter-mark-day.svg"
+    };
+    widget::row::with_capacity(2)
+        .spacing(10.0)
+        .align_y(Alignment::Center)
+        .push(
+            widget::svg(widget::svg::Handle::from_path(mark_path))
+                .width(Length::Fixed(22.0))
+                .height(Length::Fixed(22.0)),
+        )
+        .push(
+            widget::text("ISOTOPE")
+                .font(cosmic::font::semibold())
+                .size(14.0),
+        )
+        .into()
+}
+
+/// Top centre: the date and a large clock. The clock scales with the screen,
+/// as in the mock (about 9% of the width).
+pub fn date_time<'a, M: Clone + 'static>(
+    time: &crate::time::Time,
+    window_width: f32,
+    military_time: bool,
+) -> Element<'a, M> {
+    let clock_size =
+        (window_width * 0.085).clamp(72.0, 176.0) * if military_time { 1.0 } else { 0.8 };
+    widget::column::with_capacity(2)
+        .spacing(0.0)
+        .align_x(Alignment::Center)
+        .width(Length::Fill)
+        .push(widget::text::title3(time.format_date()).font(cosmic::font::semibold()))
+        .push(
+            widget::text(time.format_time(military_time))
+                .size(clock_size)
+                .font(cosmic::font::semibold()),
+        )
+        .into()
+}
+
+/// The user's picture in a circle, or their initial.
+pub fn avatar<'a, M: Clone + 'static>(
+    icon_opt: Option<&'a widget::image::Handle>,
+    full_name: &str,
+    name: &str,
+) -> Element<'a, M> {
+    if let Some(icon_handle) = icon_opt {
+        widget::image(icon_handle)
+            .width(Length::Fixed(88.0))
+            .height(Length::Fixed(88.0))
+            .content_fit(iced::ContentFit::Cover)
+            .border_radius(44.0)
+            .into()
+    } else {
+        let initial = full_name
+            .chars()
+            .chain(name.chars())
+            .find(|c| c.is_alphanumeric())
+            .map(|c| c.to_uppercase().to_string())
+            .unwrap_or_default();
+        widget::container(
+            widget::text(initial)
+                .size(36.0)
+                .font(cosmic::font::semibold()),
+        )
+        .center(Length::Fixed(88.0))
+        .class(theme::Container::custom(|theme| {
+            let cosmic = theme.cosmic();
+            let mut border: iced::Color = cosmic.background(theme.transparent).on.into();
+            border.a = 0.14;
+            widget::container::Style {
+                icon_color: Some(cosmic.background(theme.transparent).component.on.into()),
+                text_color: Some(cosmic.background(theme.transparent).component.on.into()),
+                background: Some(Background::Color(
+                    cosmic.background(theme.transparent).component.base.into(),
+                )),
+                border: Border {
+                    radius: 44.0.into(),
+                    width: 1.0,
+                    color: border,
+                },
+                ..Default::default()
+            }
+        }))
+        .into()
+    }
+}
+
+/// The whole screen's text and icons over the wallpaper take the theme's
+/// colour on its background, as the desktop does.
+pub fn on_wallpaper_class<'a>() -> theme::Container<'a> {
+    theme::Container::custom(|theme| {
+        let on: iced::Color = theme.cosmic().background(theme.transparent).on.into();
+        widget::container::Style {
+            icon_color: Some(on),
+            text_color: Some(on),
+            ..Default::default()
+        }
+    })
+}
+
+/// A scrim of the theme's background colour over a picture without a soft
+/// copy (not one of Isotope's wallpapers), so the clock and the password field
+/// read on it.
+pub fn scrim<'a, M: Clone + 'static>() -> Element<'a, M> {
+    widget::container(widget::space::horizontal())
+        .width(Length::Fill)
+        .height(Length::Fill)
+        .class(theme::Container::custom(|theme| {
+            let mut color: iced::Color = theme.cosmic().background(theme.transparent).base.into();
+            color.a = crate::greeter::background::SCRIM_ALPHA;
+            widget::container::Style {
+                background: Some(Background::Color(color)),
+                ..Default::default()
+            }
+        }))
+        .into()
+}
+
+/// The password and user name fields as glass pills (COSMIC's search field
+/// look, fully rounded).
+pub fn pill_input() -> theme::TextInput {
+    use cosmic::widget::text_input::{Appearance, StyleSheet};
+    fn pill(appearance: Appearance) -> Appearance {
+        Appearance {
+            border_radius: 999.0.into(),
+            ..appearance
+        }
+    }
+    theme::TextInput::Custom {
+        active: Box::new(|t| {
+            pill(<cosmic::Theme as StyleSheet>::active(
+                t,
+                &theme::TextInput::Search,
+            ))
+        }),
+        error: Box::new(|t| {
+            pill(<cosmic::Theme as StyleSheet>::error(
+                t,
+                &theme::TextInput::Search,
+            ))
+        }),
+        hovered: Box::new(|t| {
+            pill(<cosmic::Theme as StyleSheet>::hovered(
+                t,
+                &theme::TextInput::Search,
+            ))
+        }),
+        focused: Box::new(|t| {
+            pill(<cosmic::Theme as StyleSheet>::focused(
+                t,
+                &theme::TextInput::Search,
+            ))
+        }),
+        disabled: Box::new(|t| {
+            pill(<cosmic::Theme as StyleSheet>::disabled(
+                t,
+                &theme::TextInput::Search,
+            ))
+        }),
+    }
+}
