-fn set_gnome_button_layout(show_maximize: bool, show_minimize: bool) {
+/// GTK's `button-layout` for the window buttons: `left` mirrors upstream's
+/// layout (buttons before the colon, close first) for Isotope's left controls.
+fn gnome_button_layout(show_maximize: bool, show_minimize: bool, left: bool) -> &'static str {
+    match (left, show_maximize, show_minimize) {
+        (false, true, true) => ":minimize,maximize,close",
+        (false, true, false) => ":maximize,close",
+        (false, false, true) => ":minimize,close",
+        (false, false, false) => ":close",
+        (true, true, true) => "close,minimize,maximize:",
+        (true, true, false) => "close,maximize:",
+        (true, false, true) => "close,minimize:",
+        (true, false, false) => "close:",
+    }
+}
