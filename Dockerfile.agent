ARG BASE_IMAGE=i3-desktop:dev
# Must match the Hadron release the i3 base image was built on (see the
# top-level Dockerfile); scripts/bump-hadron.sh keeps the two in step.
ARG HADRON_VERSION=v0.6.7
FROM ${BASE_IMAGE} AS xlibre-desktop
FROM rust:1.97.0-alpine3.22 AS rust-toolchain

# isotope-agent: the single static MCP service binary (cmd/isotope-agent, with
# its packages under internal/agent). The root go.mod/go.sum are copied and
# downloaded before the source so an unrelated source edit does not invalidate
# the module cache layer; only the agent's two trees are copied after them.
FROM golang:1.25.0-alpine3.22 AS agent-gobuild
ARG VERSION=v0.0.0
ARG CUA_COMMIT=3cadb5f82e7d2ed071a2082764276ec872a52135
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/isotope-agent/ cmd/isotope-agent/
COPY internal/agent/ internal/agent/
# The version banner is read from internal/agent/buildinfo (main reads
# buildinfo.Version/buildinfo.CuaRevision), not from package main.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath \
    -ldflags="-s -w -X github.com/kairos-community/isotope/internal/agent/buildinfo.Version=${VERSION} -X github.com/kairos-community/isotope/internal/agent/buildinfo.CuaRevision=${CUA_COMMIT}" \
    -o /out/isotope-agent ./cmd/isotope-agent

FROM ghcr.io/kairos-io/hadron-toolchain:${HADRON_VERSION} AS agent-native
# The desktop root has the canonical /usr/lib/firmware symlink while the
# toolchain has an empty directory at that path; normalize it before overlay.
RUN rmdir /usr/lib/firmware
COPY --from=xlibre-desktop /usr/include/ /usr/include/
COPY --from=xlibre-desktop /usr/lib/ /usr/lib/
# Xorg protocol packages install their pkg-config metadata under share rather
# than lib; the copied X11 .pc files depend on these records.
COPY --from=xlibre-desktop /usr/share/pkgconfig/ /usr/share/pkgconfig/
# Meson invokes GLib's generators while building the schemas, AT-SPI, and GTK.
# Keep the tools matched to the copied GLib libraries from the desktop image.
COPY --from=xlibre-desktop /usr/bin/glib-* /usr/bin/
COPY --from=xlibre-desktop /usr/bin/gdbus-codegen /usr/bin/gdbus-codegen
COPY --from=xlibre-desktop /usr/bin/gio-querymodules /usr/bin/gio-querymodules
COPY --from=xlibre-desktop /usr/bin/gdk-pixbuf-pixdata /usr/bin/gdk-pixbuf-pixdata
COPY --from=xlibre-desktop /usr/share/glib-2.0/codegen/ /usr/share/glib-2.0/codegen/
# Hadron and Alpine are both musl-based. Hadron intentionally omits the
# musl-utils ldconfig helper, so borrow the helper from the pinned Rust image.
COPY --from=rust-toolchain /sbin/ldconfig /sbin/ldconfig
# Alpine's helper returns the status of its final zero-argument test; make the
# no-argument form requested here a successful musl no-op.
RUN sed -i '$a exit 0' /sbin/ldconfig
RUN ldconfig
ENV PKG_CONFIG_PATH=/usr/lib/pkgconfig:/usr/share/pkgconfig
# renovate: datasource=gitlab-tags depName=xorg/lib/libxtst registryUrl=https://gitlab.freedesktop.org extractVersion=^libXtst-(?<version>\d+(\.\d+)*)$
ARG LIBXTST_VERSION=1.2.5
# renovate: datasource=gitlab-tags depName=GNOME/gsettings-desktop-schemas registryUrl=https://gitlab.gnome.org extractVersion=^(?<version>\d+(\.\d+)*)$
ARG GSETTINGS_SCHEMAS_VERSION=47.1
# renovate: datasource=gitlab-tags depName=GNOME/at-spi2-core registryUrl=https://gitlab.gnome.org extractVersion=^(?<version>\d+(\.\d+)*)$
ARG ATSPI_VERSION=2.54.0
# renovate: datasource=gitlab-tags depName=GNOME/gtk registryUrl=https://gitlab.gnome.org extractVersion=^(?<version>\d+(\.\d+)*)$
ARG GTK3_VERSION=3.24.43
ARG CUA_COMMIT=3cadb5f82e7d2ed071a2082764276ec872a52135


FROM agent-native AS agent-runtime-build
RUN pip3 install meson ninja packaging
RUN mkdir -p /agent-runtime /build && \
    install -Dm755 /sbin/ldconfig /agent-runtime/usr/bin/ldconfig
WORKDIR /build

# XTest is Cua's native foreground keyboard and pointer injection path on X11.
RUN curl --retry-all-errors -fL --retry 5 \
      https://xorg.freedesktop.org/archive/individual/lib/libXtst-${LIBXTST_VERSION}.tar.xz \
      -o libXtst.tar.xz && \
    tar -xf libXtst.tar.xz && \
    cd libXtst-${LIBXTST_VERSION} && \
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static && \
    make -j"$(nproc)" && \
    make install && \
    make install DESTDIR=/agent-runtime && \
    test -e /agent-runtime/usr/lib/libXtst.so.6

# The AT-SPI launcher reads these schemas to decide whether accessibility is
# enabled and which toolkit behavior to expose in the desktop session.
RUN SCHEMAS_SERIES="${GSETTINGS_SCHEMAS_VERSION%.*}" && \
    curl --retry-all-errors -fL --retry 5 \
      https://download.gnome.org/sources/gsettings-desktop-schemas/${SCHEMAS_SERIES}/gsettings-desktop-schemas-${GSETTINGS_SCHEMAS_VERSION}.tar.xz \
      -o gsettings-desktop-schemas.tar.xz && \
    tar -xf gsettings-desktop-schemas.tar.xz
WORKDIR /build/gsettings-desktop-schemas-${GSETTINGS_SCHEMAS_VERSION}
RUN meson setup build --prefix=/usr --libdir=lib --buildtype=release \
      -Dintrospection=false && \
    ninja -C build && \
    DESTDIR=/agent-runtime ninja -C build install

WORKDIR /build
RUN ATSPI_SERIES="${ATSPI_VERSION%.*}" && \
    curl --retry-all-errors -fL --retry 5 \
      https://download.gnome.org/sources/at-spi2-core/${ATSPI_SERIES}/at-spi2-core-${ATSPI_VERSION}.tar.xz \
      -o at-spi2-core.tar.xz && \
    tar -xf at-spi2-core.tar.xz
WORKDIR /build/at-spi2-core-${ATSPI_VERSION}
RUN meson setup build --prefix=/usr --libdir=lib --libexecdir=libexec \
      --buildtype=release -Ddefault_bus=dbus-daemon \
      -Ddbus_daemon=/usr/bin/dbus-daemon -Duse_systemd=true \
      -Dgtk2_atk_adaptor=false -Ddocs=false \
      -Dintrospection=disabled -Dx11=enabled
RUN ninja -C build
RUN ninja -C build install
RUN DESTDIR=/agent-runtime ninja -C build install
RUN test -x /agent-runtime/usr/libexec/at-spi-bus-launcher && \
    test -x /agent-runtime/usr/libexec/at-spi2-registryd && \
    test -e /agent-runtime/usr/lib/libatk-bridge-2.0.so.0 && \
    test -e /agent-runtime/usr/share/dbus-1/services/org.a11y.Bus.service && \
    test -e /agent-runtime/usr/share/dbus-1/accessibility-services/org.a11y.atspi.Registry.service && \
    test -e /agent-runtime/usr/lib/systemd/user/at-spi-dbus-bus.service

WORKDIR /build
RUN GTK_SERIES="${GTK3_VERSION%.*}" && \
    curl --retry-all-errors -fL --retry 5 \
      https://download.gnome.org/sources/gtk+/${GTK_SERIES}/gtk+-${GTK3_VERSION}.tar.xz \
      -o gtk.tar.xz && \
    tar -xf gtk.tar.xz
WORKDIR /build/gtk+-${GTK3_VERSION}
RUN meson setup build --prefix=/usr --libdir=lib --buildtype=release \
      -Dx11_backend=true -Dwayland_backend=false -Dbroadway_backend=false \
      -Dintrospection=false -Dgtk_doc=false -Dman=false \
      -Ddemos=false -Dexamples=false -Dtests=false \
      -Dprint_backends=file -Dcolord=no
RUN ninja -C build
RUN DESTDIR=/agent-runtime ninja -C build install


FROM agent-runtime-build AS cua-build
COPY --from=rust-toolchain /usr/local/cargo/ /usr/local/cargo/
COPY --from=rust-toolchain /usr/local/rustup/ /usr/local/rustup/
# The native toolchain defaults C builds to GCC LTO, which hides ring's C/ASM
# symbols from the Rust final link. Retain its size flags without cross-LTO.
ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:${PATH} \
    RUSTFLAGS="-C target-feature=-crt-static" \
    CFLAGS="-Os -pipe -fomit-frame-pointer -fno-unroll-loops -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections" \
    LDFLAGS="-Wl,--gc-sections -Wl,--as-needed"
WORKDIR /build
RUN curl --retry-all-errors -fL --retry 5 \
      https://github.com/trycua/cua/archive/${CUA_COMMIT}.tar.gz \
      -o cua.tar.gz && \
    mkdir -p /build/cua && \
    tar -xzf cua.tar.gz --strip-components=1 -C /build/cua && \
    rm cua.tar.gz
RUN mkdir -p /cua/usr/bin && \
    cd /build/cua/libs/cua-driver/rust && \
    cargo build --locked -p cua-driver --release && \
    install -Dm755 target/release/cua-driver /cua/usr/bin/cua-driver && \
    /cua/usr/bin/cua-driver --version && \
    ldd /cua/usr/bin/cua-driver | tee /cua/ldd.txt && \
    ! grep -q 'not found' /cua/ldd.txt


FROM ${BASE_IMAGE} AS agent
ENV CUA_DRIVER_RS_TELEMETRY_ENABLED=false \
    CUA_DRIVER_RS_UPDATE_CHECK=false
COPY rootfs/agent/ /
COPY --from=agent-runtime-build /agent-runtime/ /
COPY --from=cua-build /cua/ /
COPY --from=agent-gobuild /out/isotope-agent /usr/bin/isotope-agent
# Identities for the opt-in appliance overlay only. isotope-agent-gateway is a
# locked, no-login system account that serves the public HTTPS MCP gateway;
# isotope-agent-control is a bare group used to gate the local control socket.
# The human `agent` account is intentionally NOT created here — it is created
# by the OEM/install paths (Task 5) on the live/installed system.
RUN groupadd -r isotope-agent-control && \
    groupadd -r isotope-agent-gateway && \
    useradd -r -M -N -g isotope-agent-gateway -s /usr/sbin/nologin \
      -c "Isotope agent gateway" isotope-agent-gateway && \
    chmod +x /usr/bin/isotope-agent && \
    glib-compile-schemas /usr/share/glib-2.0/schemas && \
    ldconfig && \
    ldd /usr/bin/cua-driver | tee /tmp/cua-ldd.txt && \
    ! grep -q 'not found' /tmp/cua-ldd.txt && \
    rm /tmp/cua-ldd.txt && \
    ! getent passwd agent
# The appliance upgrades along its own image line, not the i3 one it is built on.
RUN sed -i 's/^FLAVOR=.*/FLAVOR=agent/' /etc/isotope/release && \
    grep -qx 'FLAVOR=agent' /etc/isotope/release
# The label follows the file: inherited from the i3 base it would say `i3`.
LABEL io.kairos.isotope.flavor="agent"
# No update service: isotope-update upgrade keeps its direct sudo path on the
# appliance, so the root daemon, its D-Bus policy and activation, its polkit
# action and rule, and the automatic update timer and unit from the i3 image
# go. The update icon that talks to it is shadowed by
# rootfs/agent/etc/i3/config.d/30-update-tray.conf.
RUN rm -f /usr/share/dbus-1/system.d/io.kairos.IsotopeUpdate1.conf \
      /usr/share/dbus-1/system-services/io.kairos.IsotopeUpdate1.service \
      /usr/lib/systemd/system/isotope-updated.service \
      /usr/share/polkit-1/actions/io.kairos.isotope-update.policy \
      /usr/share/polkit-1/rules.d/50-isotope-update.rules \
      /usr/lib/systemd/system/isotope-autoupdate.service \
      /usr/lib/systemd/system/isotope-autoupdate.timer \
      /etc/systemd/system/timers.target.wants/isotope-autoupdate.timer && \
    ! test -e /usr/lib/systemd/system/isotope-autoupdate.timer && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q 'isotope-update'
# No firewall. The appliance is reached on its MCP gateway, whose port the
# provisioning config may change (endpoint.listen, 7443 by default), and it
# has no update service to change the firewall with. A fixed rule for 7443
# would cut off a gateway moved to another port, so the unit, its link, the
# loader and the ruleset of the i3 image go: inbound stays as on Hadron.
RUN rm -f /etc/systemd/system/sysinit.target.wants/isotope-firewall.service \
      /usr/lib/systemd/system/isotope-firewall.service \
      /usr/libexec/isotope-firewall /usr/share/isotope/firewall.nft \
      /usr/share/isotope/firewall-default.nft && \
    ! find /etc/systemd /usr/lib/systemd /usr/libexec /usr/share/isotope \
      -name 'isotope-firewall*' -o -name 'firewall*.nft' | grep -q .
# No keyring: the appliance logs in automatically, so no password ever
# unlocks it, and there is no dialog that could. Without the Secret Service,
# apps use their own plain store, as before.
RUN rm -f /etc/systemd/user/sockets.target.wants/gnome-keyring-daemon.socket \
      /usr/lib/systemd/user/gnome-keyring-daemon.socket \
      /usr/lib/systemd/user/gnome-keyring-daemon.service \
      /usr/share/dbus-1/services/org.freedesktop.secrets.service \
      /usr/share/dbus-1/services/org.freedesktop.impl.portal.Secret.service \
      /usr/share/dbus-1/services/org.gnome.keyring.service \
      /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal \
      /usr/lib/security/pam_gnome_keyring.so && \
    ! ls /usr/share/dbus-1/services | grep -q -e secrets -e keyring
# No fingerprint sign-in: an appliance driven by an agent has no person to
# touch a reader, and its sudo must stay the password the operator set. The
# fingerprint lines of the i3 image's PAM services (sudo, polkit-1 and
# i3lock, each a "-auth" line that would wake up if the fingerprint extension
# were installed) go, and no PAM file names pam_fprintd or the extension's
# pam_unix alias afterwards.
RUN for f in /etc/pam.d/* /usr/lib/pam.d/*; do \
      [ -f "$f" ] && sed -i -e '/pam_fprintd\.so/d' -e '/pam_isotope_unix\.so/d' "$f"; \
    done; \
    ! grep -rqs -e pam_fprintd -e pam_isotope_unix /etc/pam.d /usr/lib/pam.d && \
    grep -q '^auth' /etc/pam.d/sudo
# No Isotope Welcome: the appliance is driven by an agent, not a person
# setting it up at first login. Remove the app, its app list, the old picker's
# name and the i3 lines that start and float it; isotope-menu hides its
# "Install apps" and "Welcome" entries when isotope-welcome is missing.
RUN rm -f /usr/bin/isotope-welcome /usr/bin/isotope-first-run-apps \
      /usr/share/isotope/first-run-apps.list && \
    sed -i -e '/isotope-welcome/d' -e '/isotope-first-run-apps/d' /etc/i3/config && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q -e 'isotope-welcome' -e 'isotope-first-run-apps'
# No Isotope System: the appliance has no update service (the agent keeps
# `isotope upgrade` through sudo) and no admin person. isotope-menu and the
# tray fall back to the terminal when the app is missing.
RUN rm -f /usr/bin/isotope-system /usr/share/applications/isotope-system.desktop && \
    sed -i -e '/isotope-system/d' /etc/i3/config && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 | grep -q 'isotope-system'
# No automatic app updates: the Apps page went with Isotope System, and an
# appliance's apps change only when its operator changes them. The user
# timer, its service and the link that enables it for every user go.
RUN rm -f /usr/lib/systemd/user/isotope-app-updates.timer \
      /usr/lib/systemd/user/isotope-app-updates.service \
      /usr/lib/systemd/user/timers.target.wants/isotope-app-updates.timer && \
    ! find /usr/lib/systemd/user /etc/systemd/user -name 'isotope-app-updates*' 2>/dev/null | grep -q .
# No remote desktop: the appliance is driven through its MCP gateway, never
# shown to a VNC viewer (`isotope remote-desktop` also refuses on the agent
# flavor). The user unit that would run wayvnc goes.
RUN rm -f /usr/lib/systemd/user/isotope-remote-desktop.service && \
    ! find /usr/lib/systemd/user /etc/systemd/user -name 'isotope-remote-desktop*' 2>/dev/null | grep -q .
# No glibc programs: an agent that starts a downloaded glibc binary or an
# AppImage must not get an Ubuntu container pulled from the network and set up
# behind its back. The stand-in loader, the AppImage binfmt rule and its
# handler, the container's image setting and the help page go; such a program
# fails as it does on Hadron. The rule file is gone before the first boot, so
# systemd-binfmt registers nothing.
RUN rm -f /usr/lib/ld-linux-x86-64.so.2 /usr/lib/binfmt.d/isotope-appimage.conf \
      /usr/libexec/isotope-appimage /usr/share/isotope/glibc.conf \
      /usr/share/doc/isotope/glibc-programs.md && \
    ! test -e /usr/lib/ld-linux-x86-64.so.2 && ! test -e /lib64/ld-linux-x86-64.so.2 && \
    ! test -e /usr/lib/binfmt.d/isotope-appimage.conf && \
    ! test -e /usr/libexec/isotope-appimage && \
    ! test -e /usr/share/isotope/glibc.conf && \
    ! test -e /usr/share/doc/isotope/glibc-programs.md
# No clipboard history. An AI agent drives the appliance: a history would keep
# every token, password or key that the agent or a person copies, and give it
# back to anything that can run a command or read the screen, the agent
# itself included in a later, unrelated task. The i3 image's
# config.d/40-clipboard.conf (the recorder and Super+Ctrl+V) is shadowed by
# rootfs/agent's empty file; isotope-menu and isotope-help hide the entry when
# isotope-clipboard is gone.
RUN rm -f /usr/bin/isotope-clipboard /usr/bin/clipnotify && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q 'isotope-clipboard'
# No screen reader switch: nobody listens to an appliance, it is i3 (where
# the screen reader does not work), and it takes no system extensions, so
# Orca cannot be installed. isotope-menu shows the entry only on COSMIC and
# niri with the script there.
RUN rm -f /usr/bin/isotope-screen-reader && ! test -e /usr/bin/isotope-screen-reader && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q 'isotope-screen-reader'
# No software-rendering notice: the appliance is a VM, where drawing in
# software is normal, and no person reads it. The probe and the session's
# fallback (/usr/libexec/isotope-gpu-env, through ly's login shell) stay, so
# GL apps still get llvmpipe when Mesa has no driver for the GPU.
RUN rm -f /usr/bin/isotope-gpu-notice && \
    sed -i '/isotope-gpu-notice/d' /etc/i3/config && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q 'isotope-gpu-notice' && \
    test -x /usr/bin/isotope-gpu-probe
# No system extensions. An appliance must not take root code from a menu: the
# isotope-ext command goes (isotope-menu and isotope-help hide it then), and so
# do its catalog list and the setting that merges unsigned extensions. Their
# polkit action went with the policy file above, and `isotope ext`
# refuses on the agent flavor.
RUN rm -f /usr/bin/isotope-ext /etc/isotope/extensions.conf /etc/kairos/90_isotope_extensions.yaml /system/oem/93_isotope_extensions.yaml && \
    ! test -e /usr/bin/isotope-ext
# No input methods. Their software is the fcitx5 system extension, which the
# appliance cannot install (no isotope-ext, above), so the i3 session line
# that starts it and the variables that point apps at it go too. i3's
# start-desktop sources the variables only when the file exists.
RUN rm -f /etc/i3/config.d/50-input-method.conf /etc/profile.d/isotope-input-method.sh && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart /etc/profile.d | grep -q 'input-method'
# No recovery key manager either: it talks to the update service, which the
# agent does not have, and isotope-menu hides its entry without the command.
RUN rm -f /usr/bin/isotope-recovery && ! test -e /usr/bin/isotope-recovery
# No graphical installer: the appliance installs unattended
# (isotope-install-ui --progress-only), which never starts it, and without
# cage the installer keeps to the text screen whatever the boot asks.
RUN rm -f /usr/bin/cage /usr/bin/isotope-install-gui /usr/bin/isotope-install-gui-x11 && \
    ! test -e /usr/bin/cage && ! test -e /usr/bin/isotope-install-gui && \
    ! test -e /usr/bin/isotope-install-gui-x11
# ...and no live "Install Isotope" launcher either: it starts that installer
# window, and the appliance has no live desktop to start it on. The desktop
# file (hidden in the image anyway), the user-side script and the root helper
# go with it, and isotope-menu shows no entry without the script.
RUN rm -f /usr/bin/isotope-live-install /usr/libexec/isotope-live-install-run \
      /usr/share/applications/isotope-install.desktop && \
    ! test -e /usr/bin/isotope-live-install && \
    ! test -e /usr/libexec/isotope-live-install-run && \
    ! test -e /usr/share/applications/isotope-install.desktop
# No backups: the appliance keeps no user files worth a backup, and a backup of
# what an agent did would keep the secrets it handled. Without restic,
# `isotope backup` and `isotope restore` say they are not available, and
# isotope-menu hides its entry.
RUN rm -f /usr/bin/restic /usr/lib/systemd/system/isotope-backup.service \
      /usr/lib/systemd/system/isotope-backup.timer \
      /usr/lib/systemd/system/isotope-restore-finish.service \
      /etc/systemd/system/timers.target.wants/isotope-backup.timer \
      /etc/systemd/system/multi-user.target.wants/isotope-restore-finish.service && \
    ! test -e /usr/bin/restic
# No removable-disk service. The appliance has no desktop session to mount a
# disk for, and a service that mounts any disk for any logged-in user is more
# surface than an agent needs. udisks2's daemon, client, D-Bus policy and
# activation file, polkit actions, unit, udev rules and config (with
# Isotope's NTFS mount options) go. Nor are there network shares: their
# polkit actions and rule went with the update service's files above (the
# last check holds that), and their logout unit goes here.
RUN rm -rf /usr/bin/udisksctl /usr/sbin/umount.udisks2 /usr/lib/udisks2 \
      /usr/lib/libudisks2.so* /usr/include/udisks2 /usr/lib/pkgconfig/udisks2.pc \
      /usr/lib/systemd/system/udisks2.service \
      /usr/lib/tmpfiles.d/udisks2.conf /usr/lib/udev/rules.d/80-udisks2.rules \
      /usr/share/dbus-1/system.d/org.freedesktop.UDisks2.conf \
      /usr/share/dbus-1/system-services/org.freedesktop.UDisks2.service \
      /usr/share/polkit-1/actions/org.freedesktop.UDisks2.policy \
      /usr/share/bash-completion/completions/udisksctl /usr/share/zsh/site-functions/_udisks2 \
      /etc/udisks2 /var/lib/udisks2 \
      /etc/systemd/system/multi-user.target.wants/udisks2.service \
      /usr/share/polkit-1/rules.d/50-isotope-udisks.rules \
      /usr/lib/udev/rules.d/90-isotope-udisks-ignore.rules \
      /usr/lib/systemd/system/isotope-shares-logout@.service \
      /usr/lib/systemd/system/user@.service.d/50-isotope-shares-logout.conf && \
    ! test -e /usr/bin/udisksctl && ! test -e /usr/lib/udisks2 && \
    ! test -e /etc/udisks2/mount_options.conf && \
    ! grep -rqs 'io.kairos.isotope-update.shares' /usr/share/polkit-1
# No firmware updater: the appliance is a VM (no system firmware to update)
# with no tray and no Isotope System to offer one, and fwupd's daemon, LVFS
# downloads and polkit rule are surface it does not need. fwupd's binaries,
# private libraries, units (and the timer link and Isotope's drop-ins),
# D-Bus policy and activation, polkit actions and rules, LVFS remotes and
# keys, sysusers file and its fwupd-refresh user go. libsqlite3 and libxmlb
# stay: they are plain libraries, and Flatpak links libxmlb. libusb is on the
# printing list and goes with printing, below.
RUN rm -rf /usr/bin/fwupdmgr /usr/bin/fwupdtool /usr/bin/dbxtool /usr/lib/fwupd /usr/lib/fwupd-[0-9]* \
      /usr/lib/libfwupd.so* /usr/share/fwupd /etc/fwupd /etc/pki/fwupd /etc/pki/fwupd-metadata \
      /usr/lib/systemd/system/fwupd.service /usr/lib/systemd/system/fwupd-refresh.service \
      /usr/lib/systemd/system/fwupd-refresh.timer /usr/lib/systemd/system/fwupd-refresh.timer.d \
      /usr/lib/systemd/system/fwupd-refresh.service.d \
      /etc/systemd/system/timers.target.wants/fwupd-refresh.timer \
      /usr/share/dbus-1/system.d/org.freedesktop.fwupd.conf \
      /usr/share/dbus-1/system-services/org.freedesktop.fwupd.service \
      /usr/share/dbus-1/interfaces/org.freedesktop.fwupd.xml \
      /usr/share/polkit-1/actions/org.freedesktop.fwupd.policy \
      /usr/share/polkit-1/rules.d/org.freedesktop.fwupd.rules \
      /usr/share/polkit-1/rules.d/50-isotope-fwupd.rules \
      /usr/lib/sysusers.d/fwupd.conf /usr/lib/modules-load.d/fwupd-i2c.conf \
      /usr/lib/modules-load.d/fwupd-msr.conf && \
    { ! grep -q '^fwupd-refresh:' /etc/passwd || userdel fwupd-refresh; } && \
    ! test -e /usr/bin/fwupdmgr && ! ls /usr/lib/systemd/system/fwupd* >/dev/null 2>&1 && \
    ! grep -rqs 'org.freedesktop.fwupd' /usr/share/polkit-1 /usr/share/dbus-1 && \
    ! grep -q '^fwupd-refresh:' /etc/passwd
# exfatprogs is there only for udisks2's Format (the Disks page). The desktop
# image copies it to /usr/bin; remove it from /usr/sbin too in case a base
# image puts it there.
RUN for b in mkfs.exfat fsck.exfat tune.exfat exfatlabel dump.exfat exfat2img; do \
      rm -f /usr/sbin/$b /usr/bin/$b && \
      ! test -e /usr/sbin/$b && ! test -e /usr/bin/$b || exit 1; \
    done
# No company VPN service and no incoming Bluetooth files: both ask their
# questions through the tray's agents (NetworkManager's SecretAgent for the
# OpenConnect login, obexd's Agent1 for a file), and the appliance runs no
# tray, so a connect would wait for a password nobody is asked for, and
# obexd would take files with nobody to accept them. NetworkManager-
# openconnect (the plugin, its service, D-Bus policy, user and licence) and
# obexd (its binary, user unit and D-Bus activation) go; the openconnect CLI
# and WireGuard stay. NetworkManager's own D-Bus policy names the plugin's
# service too, so the check looks for a policy that owns the name (own or own_prefix) or a .name
# file that declares it, not for the name anywhere.
RUN rm -rf /usr/lib/NetworkManager/VPN/nm-openconnect-service.name \
      /usr/libexec/nm-openconnect-service /usr/libexec/nm-openconnect-service-openconnect-helper \
      /usr/lib/NetworkManager/libnm-vpn-plugin-openconnect*.so \
      /usr/share/dbus-1/system.d/nm-openconnect-service.conf /etc/dbus-1/system.d/nm-openconnect-service.conf \
      /usr/lib/sysusers.d/nm-openconnect.conf /usr/share/licenses/NetworkManager-openconnect \
      /usr/libexec/bluetooth/obexd /usr/lib/systemd/user/obex.service \
      /usr/lib/systemd/user/dbus-org.bluez.obex.service /usr/share/dbus-1/services/org.bluez.obex.service && \
    for f in /etc/passwd /etc/shadow /etc/group /etc/gshadow; do \
      [ ! -f "$f" ] || sed -i '/^nm-openconnect:/d' "$f" || exit 1; \
    done && \
    fail() { echo "agent: $*" >&2; exit 1; } && \
    ! ls /usr/libexec/nm-openconnect* /usr/lib/NetworkManager/VPN/nm-openconnect* \
      /usr/lib/NetworkManager/libnm-vpn-plugin-openconnect* >/dev/null 2>&1 || fail "nm-openconnect service files left"; \
    left=$(grep -rlsE 'own(_prefix)?="org\.freedesktop\.NetworkManager\.openconnect"|^service=org\.freedesktop\.NetworkManager\.openconnect' \
      /usr/share/dbus-1 /etc/dbus-1 /usr/lib/NetworkManager/VPN /etc/NetworkManager/VPN || true); \
    [ -z "$left" ] || fail "openconnect files left: $left"; \
    ! grep -q '^nm-openconnect:' /etc/passwd || fail "the nm-openconnect user is left"; \
    ! test -e /usr/libexec/bluetooth/obexd || fail "obexd is left"; \
    left=$(grep -rls 'org.bluez.obex' /usr/share/dbus-1/services /usr/lib/systemd/user || true); \
    [ -z "$left" ] || fail "obex files left: $left"; \
    test -x /usr/bin/openconnect || fail "the openconnect CLI is missing"
# No printing. An agent prints nothing, and CUPS, cups-browsed, Avahi and
# ipp-usb are services that listen, browse the network and take documents
# from anyone on the machine. Every file of the i3 image's printing stage
# goes (its list, /usr/share/isotope/printing.files), then the unit links
# (also the ones systemctl enable made from the units' [Install] sections:
# printer.target.wants/cups.service, multi-user.target.wants/cups.path),
# the D-Bus activation alias, /etc/cups, /etc/avahi and GTK's CUPS print
# backend (the GTK built above has print_backends=file only, so it would not
# load it, but it links libcups, which is gone).
RUN while IFS= read -r f; do rm -f "$f"; done < /usr/share/isotope/printing.files && \
    rm -rf /etc/cups /etc/avahi /etc/ipp-usb /usr/lib/cups /usr/share/cups /usr/share/ipp-usb \
      /usr/share/ghostscript /var/lib/cups /var/spool/cups /var/cache/cups \
      /etc/systemd/system/multi-user.target.wants/cups.service \
      /etc/systemd/system/multi-user.target.wants/cups-browsed.service \
      /etc/systemd/system/multi-user.target.wants/avahi-daemon.service \
      /etc/systemd/system/sockets.target.wants/cups.socket \
      /etc/systemd/system/sockets.target.wants/avahi-daemon.socket \
      /etc/systemd/system/dbus-org.freedesktop.Avahi.service \
      /usr/lib/gtk-3.0/3.0.0/printbackends/libprintbackend-cups.so && \
    find /etc/systemd \( -name 'cups*' -o -name 'avahi*' -o -name '*ipp-usb*' \) -exec rm -rf {} + && \
    fail() { echo "agent: $*" >&2; exit 1; } && \
    for b in /usr/sbin/cupsd /usr/sbin/cups-browsed /usr/sbin/avahi-daemon /usr/sbin/ipp-usb /usr/bin/gs /usr/sbin/lpadmin; do \
      ! test -e "$b" || fail "$b is left"; \
    done && \
    ! ls /usr/lib/libcups.so* /usr/lib/libavahi-*.so* >/dev/null 2>&1 || fail "printing libraries are left" && \
    ! find /etc/systemd /usr/lib/systemd /usr/lib/udev -name 'cups*' -o -name 'avahi*' -o -name '*ipp-usb*' | grep -q . || fail "printing units are left" && \
    ! test -e /usr/lib/gtk-3.0/3.0.0/printbackends/libprintbackend-cups.so || fail "GTK's CUPS backend is left"
