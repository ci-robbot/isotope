// The person at the screen may mount, eject and power off removable disks
// without a password, from a file manager or the Backup page in Welcome.
// "local" and "active" mean a session on this machine's seat, not an SSH or
// a background one; anyone else falls through to udisks2's own policy.
//
// This is a convenience, not the gate: udisks2's own policy already allows
// these actions to an active local session (allow_active=yes) for disks it
// does not call system disks. What keeps the Kairos partitions out of reach
// is 90-isotope-udisks-ignore.rules (UDISKS_SYSTEM), so do not loosen
// anything here thinking this file is what protects them.
//
// Not granted here: filesystem-unmount-others (udisks2 already lets a user
// unmount what they mounted) and filesystem-mount-system (a disk marked as
// a system disk stays behind an administrator's password).
polkit.addRule(function(action, subject) {
    var allowed = [
        "org.freedesktop.udisks2.filesystem-mount",
        "org.freedesktop.udisks2.eject-media",
        "org.freedesktop.udisks2.power-off-drive"
    ];
    if (allowed.indexOf(action.id) >= 0 && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});

// Formatting a removable disk (Isotope System's Disks page): an
// administrator at the screen, without a password; nobody else, and never
// from an inactive or remote session. System disks ask for
// modify-device-system, which no Isotope rule grants.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.udisks2.modify-device") {
        return (subject.local && subject.active && subject.isInGroup("admin"))
            ? polkit.Result.YES : polkit.Result.NO;
    }
});
