msgstr "Il file contiene l'intero backup, cifrato con la sua password. isotope restore lo legge su qualsiasi macchina."

#: cmd/isotope-system/backup_setup.go
msgid "Plug in a USB disk."
msgstr "Collega un disco USB."

#: cmd/isotope-system/backup_setup.go
msgid "File name"
msgstr "Nome del file"

#: cmd/isotope-system/backup_setup.go
