#: cmd/isotope-system/shares.go
msgid "It is removed from the list, with its saved password. A mounted share stays mounted until you unmount it."
msgstr "Viene rimossa dall'elenco, con la sua password salvata. Una condivisione montata resta montata finché non la smonti."

#: cmd/isotope-system/shares.go
#, go-format
msgid "Could not forget %s"
msgstr "Impossibile dimenticare %s"

#: cmd/isotope-system/shares.go
msgid "Network shares"
msgstr "Condivisioni di rete"

#: cmd/isotope-system/shares.go
msgid "The update service (isotope-updated), which mounts network shares, is not available."
msgstr "Il servizio di aggiornamento (isotope-updated), che monta le condivisioni di rete, non è disponibile."

#: cmd/isotope-system/shares.go
msgid "No saved shares. Connect to an SMB (Windows, Samba, a NAS) or NFS server."
msgstr "Nessuna condivisione salvata. Connettiti a un server SMB (Windows, Samba, un NAS) o NFS."

#: cmd/isotope-system/shares.go
msgid "Connect to server…"
msgstr "Connetti al server…"

#: cmd/isotope-system/shares.go
msgid "a password or a domain needs a user name"
msgstr "una password o un dominio richiedono un nome utente"

#: cmd/isotope-system/shares.go
msgid "Connect to server"
msgstr "Connetti al server"

#: cmd/isotope-system/shares.go
msgid "Mount a shared folder of another computer. It shows in your files under /run/media."
msgstr "Monta una cartella condivisa di un altro computer. Appare nei tuoi file sotto /run/media."

#: cmd/isotope-system/shares.go
#, go-format
msgid "Mount %s"
msgstr "Monta %s"

#: cmd/isotope-system/shares.go
#, go-format
msgid "Type the password for %s."
msgstr "Scrivi la password per %s."

#: cmd/isotope-system/shares.go
#, go-format
msgid "the share is mounted and saved, but its password could not be saved in the keyring: %s"
msgstr "la condivisione è montata e salvata, ma non è stato possibile salvarne la password nel portachiavi: %s"

#: cmd/isotope-system/shares.go
msgid "Server address"
msgstr "Indirizzo del server"

#: cmd/isotope-system/shares.go
msgid "smb://server/share or nfs://server/export"
msgstr "smb://server/condivisione o nfs://server/export"

#: cmd/isotope-system/shares.go
msgid "NFS needs no password. Isotope uses NFS version 4.1 or later. Files show the owners the server has, which may not be you."
msgstr "NFS non richiede una password. Isotope usa NFS versione 4.1 o successiva. I file mostrano i proprietari che ha il server, che potrebbero non essere te."

#: cmd/isotope-system/shares.go
msgid "Empty for a guest."
msgstr "Vuoto per un ospite."

#: cmd/isotope-system/shares.go
msgid "Domain"
msgstr "Dominio"

#: cmd/isotope-system/shares.go
msgid "Remember this share on this page"
msgstr "Ricorda questa condivisione in questa pagina"

#: cmd/isotope-system/shares.go
msgid "Mount it at login"
msgstr "Montala all'accesso"

#: cmd/isotope-system/shares.go
msgid "Remember the password in your keyring"
msgstr "Ricorda la password nel tuo portachiavi"

#: cmd/isotope-system/sysinfo.go
msgid "COSMIC Settings"
msgstr "Impostazioni di COSMIC"

#: cmd/isotope-system/sysinfo.go
msgid "the control center"
msgstr "il centro di controllo"

#: cmd/isotope-system/udisks.go
msgid "listing the disks: %w"
msgstr "elenco dei dischi: %w"

#: cmd/isotope-system/udisks.go
msgid "cannot format as %q, only as exfat or ext4"
msgstr "impossibile formattare come %q, solo come exfat o ext4"

#: cmd/isotope-system/udisks.go
msgid "this is Isotope's system disk, it cannot be formatted"
msgstr "questo è il disco di sistema di Isotope, non può essere formattato"

#: cmd/isotope-system/udisks.go
msgid "this is an internal disk, it cannot be formatted here"
msgstr "questo è un disco interno, non può essere formattato qui"

#: cmd/isotope-system/udisks.go
msgid "%s is mounted: unmount it first"
msgstr "%s è montato: smontalo prima"

#: cmd/isotope-system/udisks.go
msgid "cannot tell what is mounted on the disk: %w"
msgstr "impossibile stabilire cosa è montato sul disco: %w"

#: cmd/isotope-system/udisks.go
msgid "the disk has no block device"
msgstr "il disco non ha un dispositivo a blocchi"

#: cmd/isotope-system/udisks.go
msgid "the disk is not connected"
msgstr "il disco non è collegato"

#: cmd/isotope-system/udisks.go
msgid "making the partition table: %w"
msgstr "creazione della tabella delle partizioni: %w"

#: cmd/isotope-system/udisks.go
msgid "making the %[1]s filesystem: %[2]w"
msgstr "creazione del file system %[1]s: %[2]w"

#: cmd/isotope-system/ui.go
msgid "The update service (isotope-updated) is not available: the system bus cannot be reached."
msgstr "Il servizio di aggiornamento (isotope-updated) non è disponibile: il bus di sistema non è raggiungibile."

#: cmd/isotope-system/ui.go
msgid "Waiting for the first lines…"
msgstr "In attesa delle prime righe…"

#: cmd/isotope-system/wireguard.go
msgid "line %d: %s"
msgstr "riga %d: %s"

#: cmd/isotope-system/wireguard.go
msgid "not an address"
msgstr "non è un indirizzo"

#: cmd/isotope-system/wireguard.go
msgid "not a valid number"
msgstr "non è un numero valido"

#: cmd/isotope-system/wireguard.go
msgid "a second [Interface] section"
msgstr "una seconda sezione [Interface]"

#: cmd/isotope-system/wireguard.go
msgid "unknown section"
msgstr "sezione sconosciuta"

#: cmd/isotope-system/wireguard.go
msgid "not a Key = Value line"
msgstr "non è una riga Chiave = Valore"

#: cmd/isotope-system/wireguard.go
msgid "a setting outside a section"
msgstr "un'impostazione fuori da una sezione"

#: cmd/isotope-system/wireguard.go
msgid "duplicate key"
msgstr "chiave duplicata"

#: cmd/isotope-system/wireguard.go
msgid "PrivateKey is not a 32-byte base64 key"
msgstr "PrivateKey non è una chiave base64 di 32 byte"

#: cmd/isotope-system/wireguard.go
msgid "Address is %v"
msgstr "Address: %v"

#: cmd/isotope-system/wireguard.go
msgid "MTU is %v"
msgstr "MTU: %v"

#: cmd/isotope-system/wireguard.go
msgid "ListenPort is %v"
msgstr "ListenPort: %v"

#: cmd/isotope-system/wireguard.go
msgid "FwMark is %v"
msgstr "FwMark: %v"

#: cmd/isotope-system/wireguard.go
msgid "a Table number is not supported: NetworkManager sets the routes. Use Table = off or auto"
msgstr "un numero di Table non è supportato: le route le imposta NetworkManager. Usa Table = off o auto"

#. TRANSLATORS: %[1]s is a wg-quick key name followed by a space (PreUp, SaveConfig…), or empty.
#: cmd/isotope-system/wireguard.go
msgid "%[1]ssetting is not supported: Isotope runs WireGuard through NetworkManager, which does not run it"
msgstr "l'impostazione %[1]snon è supportata: Isotope usa WireGuard tramite NetworkManager, che non la esegue"

#: cmd/isotope-system/wireguard.go
msgid "unknown key %s in [Interface]"
msgstr "chiave sconosciuta %s in [Interface]"

#: cmd/isotope-system/wireguard.go
msgid "PublicKey is not a 32-byte base64 key"
msgstr "PublicKey non è una chiave base64 di 32 byte"

#: cmd/isotope-system/wireguard.go
msgid "PresharedKey is not a 32-byte base64 key"
msgstr "PresharedKey non è una chiave base64 di 32 byte"

#: cmd/isotope-system/wireguard.go
msgid "AllowedIPs is %v"
msgstr "AllowedIPs: %v"

#: cmd/isotope-system/wireguard.go
msgid "Endpoint is not host:port"
msgstr "Endpoint non è nella forma host:porta"

#: cmd/isotope-system/wireguard.go
msgid "PersistentKeepalive is %v"
msgstr "PersistentKeepalive: %v"

#: cmd/isotope-system/wireguard.go
msgid "unknown key %s in [Peer]"
msgstr "chiave sconosciuta %s in [Peer]"

#: cmd/isotope-system/wireguard.go
msgid "no [Interface] section"
msgstr "nessuna sezione [Interface]"

#: cmd/isotope-system/wireguard.go
msgid "the [Interface] section has no PrivateKey"
msgstr "la sezione [Interface] non ha PrivateKey"

#: cmd/isotope-system/wireguard.go
msgid "the [Peer] section has no PublicKey"
msgstr "la sezione [Peer] non ha PublicKey"

#: cmd/isotope-system/wireguard.go
msgid "AllowedIPs has 0.0.0.0/0 but the [Interface] has no IPv4 Address: IPv4 traffic would not use the tunnel"
msgstr "AllowedIPs contiene 0.0.0.0/0 ma [Interface] non ha un Address IPv4: il traffico IPv4 non userebbe il tunnel"

#: cmd/isotope-system/wireguard.go
msgid "the IPv4 DNS server needs an IPv4 Address in [Interface]"
msgstr "il server DNS IPv4 richiede un Address IPv4 in [Interface]"

#: cmd/isotope-system/wireguard.go
msgid "the IPv6 DNS server needs an IPv6 Address in [Interface]"
msgstr "il server DNS IPv6 richiede un Address IPv6 in [Interface]"
