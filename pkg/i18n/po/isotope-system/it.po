#: cmd/isotope-system/apps.go
#, go-format
msgid "Updates · %d"
msgstr "Aggiornamenti · %d"

#: cmd/isotope-system/apps.go
#: cmd/isotope-system/args.go
#: cmd/isotope-system/page_updates.go
msgid "Updates"
msgstr "Aggiornamenti"

#: cmd/isotope-system/apps.go
msgctxt "app state"
msgid "Installed"
msgstr "Installata"

#: cmd/isotope-system/apps.go
msgid "in Isotope's extension catalog · needs an administrator"
msgstr "nel catalogo delle estensioni di Isotope · serve un amministratore"

#: cmd/isotope-system/apps.go
msgid "installed · managed in Extensions"
msgstr "installata · gestita in Estensioni"

#: cmd/isotope-system/apps.go
#, go-format
msgid "Also installed: %[1]d system extension (%[2]s)."
msgid_plural "Also installed: %[1]d system extensions (%[2]s)."
msgstr[0] "Installate anche: %[1]d estensione di sistema (%[2]s)."
msgstr[1] "Installate anche: %[1]d estensioni di sistema (%[2]s)."

#: cmd/isotope-system/apps.go
msgid "running"
msgstr "in esecuzione"

#: cmd/isotope-system/apps.go
#, go-format
msgid "%s runtime"
msgstr "runtime %s"

#: cmd/isotope-system/apps.go
msgid "Its permissions could not be compared. Automatic updates skip it until you update it here."
msgstr "Non è stato possibile confrontare i suoi permessi. Gli aggiornamenti automatici lo saltano finché non lo aggiorni qui."

#. TRANSLATORS: start it with the translation of "Asks for more:", which the page shows in amber.
#: cmd/isotope-system/apps.go
#, go-format
msgid "Asks for more: %s. Automatic updates skip it until you agree."
msgstr "Chiede di più: %s. Gli aggiornamenti automatici lo saltano finché non acconsenti."

#: cmd/isotope-system/apps.go
msgid "running, restarts later"
msgstr "in esecuzione, si riavvia dopo"

#: cmd/isotope-system/apps.go
#, go-format
msgid "Used by %s."
msgstr "Usato da %s."

#: cmd/isotope-system/apps.go
msgid "A runtime or extension your apps use."
msgstr "Un runtime o un'estensione che le tue app usano."

#: cmd/isotope-system/apps.go
#, go-format
msgid "Ready to update · %d"
msgstr "Pronti da aggiornare · %d"

#: cmd/isotope-system/apps.go
#, go-format
msgid "%[1]s uses the %[2]s runtime, which no longer gets security fixes. Only its developer can move it to a newer one."
msgid_plural "%[1]s use the %[2]s runtime, which no longer gets security fixes. Only their developer can move them to a newer one."
msgstr[0] "%[1]s usa il runtime %[2]s, che non riceve più correzioni di sicurezza. Solo il suo sviluppatore può passarla a uno più recente."
msgstr[1] "%[1]s usano il runtime %[2]s, che non riceve più correzioni di sicurezza. Solo i loro sviluppatori possono passarle a uno più recente."

#: cmd/isotope-system/apps.go
#, go-format
msgid "%[1]s and %[2]s"
msgstr "%[1]s e %[2]s"

#: cmd/isotope-system/apps.go
msgid "Off. You are told when updates are ready, and you install them here."
msgstr "Disattivo. Ricevi un avviso quando ci sono aggiornamenti e li installi qui."

