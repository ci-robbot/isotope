#: cmd/isotope-system/backup_setup.go
msgid "REST server"
msgstr "Servidor REST"

#: cmd/isotope-system/backup_setup.go
msgid "restic's rest-server, over HTTP or HTTPS"
msgstr "El rest-server de restic, por HTTP o HTTPS"

#: cmd/isotope-system/backup_setup.go
msgid "Amazon S3, or a service that works like it"
msgstr "Amazon S3, o un servicio que funciona igual"

#: cmd/isotope-system/backup_setup.go
msgid "A server you reach with SSH"
msgstr "Un servidor al que se accede por SSH"

#: cmd/isotope-system/backup_setup.go
msgid "The folder name has a control character."
msgstr "El nombre de la carpeta contiene un carácter de control."

#: cmd/isotope-system/backup_setup.go
msgid "The folder cannot have . or .. in it."
msgstr "La carpeta no puede contener . ni .."

#: cmd/isotope-system/backup_setup.go
msgid "Type the folder on the disk for the backup."
msgstr "Escriba la carpeta del disco para la copia de seguridad."

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "The value of %s has a line break in it."
msgstr "El valor de %s contiene un salto de línea."

#: cmd/isotope-system/backup_setup.go
msgid "Type the address of the server, starting with http:// or https://."
msgstr "Escriba la dirección del servidor, que empiece por http:// o https://."

#: cmd/isotope-system/backup_setup.go
msgid "Put the user and the password in their fields, not in the address."
msgstr "Ponga el usuario y la contraseña en sus campos, no en la dirección."

#: cmd/isotope-system/backup_setup.go
msgid "Type the endpoint of the service, such as https://s3.amazonaws.com."
msgstr "Escriba el endpoint del servicio, por ejemplo https://s3.amazonaws.com."

#: cmd/isotope-system/backup_setup.go
msgid "Type the name of the bucket."
msgstr "Escriba el nombre del bucket."

#: cmd/isotope-system/backup_setup.go
msgid "The path has a control character."
msgstr "La ruta contiene un carácter de control."

#: cmd/isotope-system/backup_setup.go
msgid "Type the access key ID and the secret access key."
msgstr "Escriba el ID de la clave de acceso y la clave de acceso secreta."

#: cmd/isotope-system/backup_setup.go
msgid "Type the user and the server as user@server."
msgstr "Escriba el usuario y el servidor como usuario@servidor."

#: cmd/isotope-system/backup_setup.go
msgid "The port is a number from 1 to 65535."
msgstr "El puerto es un número de 1 a 65535."

#: cmd/isotope-system/backup_setup.go
msgid "Type the folder on the server for the backup."
msgstr "Escriba la carpeta del servidor para la copia de seguridad."

#: cmd/isotope-system/backup_setup.go
msgid "Type a file name."
msgstr "Escriba un nombre de archivo."

#: cmd/isotope-system/backup_setup.go
msgid "A file name has no /."
msgstr "Un nombre de archivo no contiene /."

#: cmd/isotope-system/backup_setup.go
msgid "A file name does not start with a dot."
msgstr "Un nombre de archivo no empieza por un punto."

#: cmd/isotope-system/backup_setup.go
msgid "The file name has a control character."
msgstr "El nombre del archivo contiene un carácter de control."

#. TRANSLATORS: %[1]s is when the backup was made ("2 days ago"), %[2]s the hostname of its machine.
#: cmd/isotope-system/backup_setup.go
#, go-format
msgid ""
"The backup of %[1]s from %[2]s brings this whole machine back as it was: the users and their passwords, the hostname, every home, the SSH keys, the extensions, the settings and the Flatpak apps (installed again after the restart).\n"
"What is on this machine now is replaced. The machine restarts at the end."
msgstr ""
"La copia de seguridad de %[1]s desde %[2]s devuelve este equipo entero a como estaba: los usuarios y sus contraseñas, el nombre del equipo, todas las carpetas personales, las claves SSH, las extensiones, la configuración y las aplicaciones Flatpak (instaladas de nuevo tras el reinicio).\n"
"Lo que hay ahora en este equipo se reemplaza. Al final el equipo se reinicia."

#. TRANSLATORS: %s is when the backup was made ("2 days ago").
#: cmd/isotope-system/backup_setup.go
#, go-format
msgid ""
"The backup of %s brings this whole machine back as it was: the users and their passwords, the hostname, every home, the SSH keys, the extensions, the settings and the Flatpak apps (installed again after the restart).\n"
"What is on this machine now is replaced. The machine restarts at the end."
msgstr ""
"La copia de seguridad de %s devuelve este equipo entero a como estaba: los usuarios y sus contraseñas, el nombre del equipo, todas las carpetas personales, las claves SSH, las extensiones, la configuración y las aplicaciones Flatpak (instaladas de nuevo tras el reinicio).\n"
"Lo que hay ahora en este equipo se reemplaza. Al final el equipo se reinicia."

#: cmd/isotope-system/backup_setup.go
msgid "Plug in a USB disk, and choose it."
msgstr "Conecte un disco USB y elíjalo."

#: cmd/isotope-system/backup_setup.go
#: cmd/isotope-system/model.go
#, go-format
msgid "%s (USB disk)"
msgstr "%s (disco USB)"

#: cmd/isotope-system/backup_setup.go
msgid "Connect to the server and confirm its key."
msgstr "Conéctese al servidor y confirme su clave."

#: cmd/isotope-system/backup_setup.go
msgid "Choose the kind of server."
msgstr "Elija el tipo de servidor."

#: cmd/isotope-system/backup_setup.go
msgid "udisks2 is not running"
msgstr "udisks2 no se está ejecutando"

#: cmd/isotope-system/backup_setup.go
msgid "it was mounted nowhere"
msgstr "no se montó en ningún sitio"

#: cmd/isotope-system/backup_setup.go
#: cmd/isotope-system/shares.go
#, go-format
msgid "Could not mount %s"
msgstr "No se pudo montar %s"

#: cmd/isotope-system/backup_setup.go
msgid "Set up the backup"
msgstr "Configurar la copia de seguridad"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "Backups go to %s. Create a new backup there, with a new password, or use a backup that is there already, with its password."
msgstr "Las copias de seguridad van a %s. Cree allí una copia de seguridad nueva, con una contraseña nueva, o use una que ya esté allí, con su contraseña."

#: cmd/isotope-system/backup_setup.go
msgid "Use an existing backup"
msgstr "Usar una copia existente"

#: cmd/isotope-system/backup_setup.go
msgid "Create a new backup"
msgstr "Crear una copia nueva"

#: cmd/isotope-system/backup_setup.go
msgid "Could not make a password"
msgstr "No se pudo crear una contraseña"

#: cmd/isotope-system/backup_setup.go
msgid "The password of this backup"
msgstr "La contraseña de esta copia de seguridad"

#: cmd/isotope-system/backup_setup.go
msgid "Write it down and keep it away from this computer. It is shown only now. Without it, nobody can read the backup, not even you."
msgstr "Anótela y guárdela lejos de este equipo. Solo se muestra ahora. Sin ella nadie puede leer la copia de seguridad, ni siquiera usted."

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "Type the password of the backup in %s."
msgstr "Escriba la contraseña de la copia de seguridad de %s."

#: cmd/isotope-system/backup_setup.go
msgid "Use this backup"
msgstr "Usar esta copia"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "Setting up the backup in %s…"
msgstr "Configurando la copia de seguridad en %s…"

#: cmd/isotope-system/backup_setup.go
msgid "The backup was not set up"
msgstr "No se configuró la copia de seguridad"

#: cmd/isotope-system/backup_setup.go
msgid "The backup is set up"
msgstr "La copia de seguridad está configurada"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "This machine backs up to %s. Click Back up now for the first backup, or choose a schedule."
msgstr "Este equipo hace copias de seguridad en %s. Pulse Hacer una copia de seguridad ahora para la primera, o elija una programación."

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "Could not read the backup's SSH key: %s"
msgstr "No se pudo leer la clave SSH de la copia de seguridad: %s"

#: cmd/isotope-system/backup_setup.go
msgid "Cannot connect"
msgstr "No se puede conectar"

#: cmd/isotope-system/backup_setup.go
msgid "the server sent no key"
msgstr "el servidor no envió ninguna clave"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "Could not reach %s"
msgstr "No se pudo acceder a %s"

#: cmd/isotope-system/backup_setup.go
msgid "Is this the server's key?"
msgstr "¿Es esta la clave del servidor?"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "%s (port %d) sent these keys. On the server, ssh-keygen -lf /etc/ssh/ssh_host_*_key.pub shows its own, with their type. Choose the key you compared, and say yes only when it is the same."
msgstr "%s (puerto %d) envió estas claves. En el servidor, ssh-keygen -lf /etc/ssh/ssh_host_*_key.pub muestra las suyas, con su tipo. Elija la clave que comparó y responda sí solo si es la misma."

#: cmd/isotope-system/backup_setup.go
#: cmd/isotope-system/page_bluetooth.go
msgid "No"
msgstr "No"

#: cmd/isotope-system/backup_setup.go
#: cmd/isotope-system/page_bluetooth.go
msgid "Yes"
msgstr "Sí"

#: cmd/isotope-system/backup_setup.go
msgid "Key"
msgstr "Clave"

#: cmd/isotope-system/backup_setup.go
msgid "Cannot export"
msgstr "No se puede exportar"

#: cmd/isotope-system/backup_setup.go
msgid "USB disks cannot be listed: udisks2 is not running."
msgstr "No se pueden listar los discos USB: udisks2 no se está ejecutando."

#: cmd/isotope-system/backup_setup.go
msgid "Export to a file"
msgstr "Exportar a un archivo"

#: cmd/isotope-system/backup_setup.go
msgid "The file holds the whole backup, encrypted with its password. isotope restore reads it on any machine."
msgstr "El archivo contiene la copia de seguridad entera, cifrada con su contraseña. isotope restore la lee en cualquier equipo."

#: cmd/isotope-system/backup_setup.go
msgid "Plug in a USB disk."
msgstr "Conecte un disco USB."

#: cmd/isotope-system/backup_setup.go
msgid "File name"
msgstr "Nombre del archivo"

#: cmd/isotope-system/backup_setup.go
msgid "Written at the top of the disk."
msgstr "Se escribe en la carpeta raíz del disco."

#: cmd/isotope-system/backup_setup.go
msgid "Export"
msgstr "Exportar"

#: cmd/isotope-system/backup_setup.go
msgid "The export did not start"
msgstr "La exportación no se inició"

#: cmd/isotope-system/backup_setup.go
msgid "Restoring over a machine in use is done in a terminal: isotope restore --only homes,apps,extensions"
msgstr "La restauración sobre un equipo en uso se hace en una terminal: isotope restore --only homes,apps,extensions"

#. TRANSLATORS: %s is the daemon's reason, in English, such as "there are users with a home".
#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "A whole restore is offered only on a new machine, and on this one %s."
msgstr "La restauración completa solo se ofrece en un equipo nuevo, y en este %s."

#: cmd/isotope-system/backup_setup.go
msgid "Choose where the backup is"
msgstr "Elija dónde está la copia de seguridad"

#: cmd/isotope-system/backup_setup.go
msgid "Restore this machine from a backup"
msgstr "Restaurar este equipo desde una copia de seguridad"

#: cmd/isotope-system/backup_setup.go
msgid "Find the backups"
msgstr "Buscar las copias"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "Reading the backups in %s…"
msgstr "Leyendo las copias de seguridad de %s…"

#: cmd/isotope-system/backup_setup.go
msgid "Could not read the backup"
msgstr "No se pudo leer la copia de seguridad"

#: cmd/isotope-system/backup_setup.go
msgid "There is no backup there"
msgstr "Ahí no hay ninguna copia de seguridad"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "%s holds no backup yet."
msgstr "%s aún no contiene ninguna copia de seguridad."

#: cmd/isotope-system/backup_setup.go
msgid "Which backup?"
msgstr "¿Qué copia de seguridad?"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "The backups in %s, the newest first."
msgstr "Las copias de seguridad de %s, de la más reciente a la más antigua."

#: cmd/isotope-system/backup_setup.go
#: cmd/isotope-system/page_backup.go
#: cmd/isotope-system/page_security.go
msgid "Continue"
msgstr "Continuar"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "Backup %s"
msgstr "Copia %s"

#: cmd/isotope-system/backup_setup.go
msgid "Restore this machine?"
msgstr "¿Restaurar este equipo?"

#: cmd/isotope-system/backup_setup.go
msgid "Restore and restart"
msgstr "Restaurar y reiniciar"

#: cmd/isotope-system/backup_setup.go
msgid "The restore did not start"
msgstr "La restauración no se inició"

#: cmd/isotope-system/backup_setup.go
msgid "not mounted"
msgstr "sin montar"

#: cmd/isotope-system/backup_setup.go
#, go-format
msgid "%s free"
msgstr "%s libres"

#: cmd/isotope-system/backup_setup.go
msgid "Back up this machine"
msgstr "Copia de seguridad de este equipo"

#: cmd/isotope-system/backup_setup.go
msgid "A USB disk"
msgstr "Un disco USB"

#: cmd/isotope-system/backup_setup.go
msgid "Plugged in to this computer"
msgstr "Conectado a este equipo"

#: cmd/isotope-system/backup_setup.go
msgid "A remote server"
msgstr "Un servidor remoto"

#: cmd/isotope-system/backup_setup.go
msgid "A REST server, S3 or SFTP"
msgstr "Un servidor REST, S3 o SFTP"

#: cmd/isotope-system/backup_setup.go
msgid "It shows here when it is plugged in. A disk with exFAT, FAT, NTFS, ext4, Btrfs or XFS can hold backups."
msgstr "Aparece aquí cuando se conecta. Un disco con exFAT, FAT, NTFS, ext4, Btrfs o XFS puede guardar copias de seguridad."

