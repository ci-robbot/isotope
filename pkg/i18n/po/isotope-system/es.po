#: cmd/isotope-system/apps.go
#, go-format
msgid "Updates · %d"
msgstr "Actualizaciones · %d"

#: cmd/isotope-system/apps.go
#: cmd/isotope-system/args.go
#: cmd/isotope-system/page_updates.go
msgid "Updates"
msgstr "Actualizaciones"

#: cmd/isotope-system/apps.go
msgctxt "app state"
msgid "Installed"
msgstr "Instalada"

#: cmd/isotope-system/apps.go
msgid "in Isotope's extension catalog · needs an administrator"
msgstr "en el catálogo de extensiones de Isotope · necesita un administrador"

#: cmd/isotope-system/apps.go
msgid "installed · managed in Extensions"
msgstr "instalada · se gestiona en Extensiones"

#: cmd/isotope-system/apps.go
#, go-format
msgid "Also installed: %[1]d system extension (%[2]s)."
msgid_plural "Also installed: %[1]d system extensions (%[2]s)."
msgstr[0] "También instalada: %[1]d extensión del sistema (%[2]s)."
msgstr[1] "También instaladas: %[1]d extensiones del sistema (%[2]s)."

#: cmd/isotope-system/apps.go
msgid "running"
msgstr "en ejecución"

#: cmd/isotope-system/apps.go
#, go-format
msgid "%s runtime"
msgstr "runtime %s"

#: cmd/isotope-system/apps.go
msgid "Its permissions could not be compared. Automatic updates skip it until you update it here."
msgstr "No se pudieron comparar sus permisos. Las actualizaciones automáticas lo omiten hasta que lo actualice aquí."

#. TRANSLATORS: start it with the translation of "Asks for more:", which the page shows in amber.
#: cmd/isotope-system/apps.go
#, go-format
msgid "Asks for more: %s. Automatic updates skip it until you agree."
msgstr "Pide más: %s. Las actualizaciones automáticas lo omiten hasta que lo acepte."

#: cmd/isotope-system/apps.go
msgid "running, restarts later"
msgstr "en ejecución, se reinicia después"

#: cmd/isotope-system/apps.go
#, go-format
msgid "Used by %s."
msgstr "Lo usa %s."

#: cmd/isotope-system/apps.go
msgid "A runtime or extension your apps use."
msgstr "Un runtime o extensión que usan sus aplicaciones."

#: cmd/isotope-system/apps.go
#, go-format
msgid "Ready to update · %d"
msgstr "Listas para actualizar · %d"

#: cmd/isotope-system/apps.go
#, go-format
msgid "%[1]s uses the %[2]s runtime, which no longer gets security fixes. Only its developer can move it to a newer one."
msgid_plural "%[1]s use the %[2]s runtime, which no longer gets security fixes. Only their developer can move them to a newer one."
msgstr[0] "%[1]s usa el runtime %[2]s, que ya no recibe correcciones de seguridad. Solo su desarrollador puede pasarla a uno más reciente."
msgstr[1] "%[1]s usan el runtime %[2]s, que ya no recibe correcciones de seguridad. Solo sus desarrolladores pueden pasarlas a uno más reciente."

#: cmd/isotope-system/apps.go
#, go-format
msgid "%[1]s and %[2]s"
msgstr "%[1]s y %[2]s"

#: cmd/isotope-system/apps.go
msgid "Off. You are told when updates are ready, and you install them here."
msgstr "Desactivado. Se le avisa cuando hay actualizaciones y usted las instala aquí."

