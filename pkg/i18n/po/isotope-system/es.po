msgstr "Privativa"

#: cmd/isotope-system/apps.go
#, go-format
msgid "The app goes, and %s comes back. Its settings and files stay, so installing it again picks up where you left off."
msgstr "La aplicación se quita y se liberan %s. Su configuración y sus archivos se conservan, así que al instalarla de nuevo continúa donde lo dejó."

#: cmd/isotope-system/apps.go
