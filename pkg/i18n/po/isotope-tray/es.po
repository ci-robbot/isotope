msgstr "Restaurando una copia de seguridad…"

#: cmd/isotope/menu.go
msgid "Update failed; restart before trying again"
msgstr "Falló la actualización; reinicie antes de volver a intentarlo"

#: cmd/isotope/menu.go
msgid "Update interrupted; restart before trying again"
msgstr "Actualización interrumpida; reinicie antes de volver a intentarlo"

#: cmd/isotope/menu.go
#, go-format
msgid "Isotope %s is installed: restart to finish"
msgstr "Isotope %s está instalado: reinicie para terminar"

#: cmd/isotope/menu.go
msgid "Update installed; restart to use it"
msgstr "Actualización instalada; reinicie para usarla"

#: cmd/isotope/menu.go
#, go-format
msgid "Error: %s"
msgstr "Error: %s"

#: cmd/isotope/menu.go
#, go-format
msgid "Install %s"
msgstr "Instalar %s"

#: cmd/isotope/menu.go
#, go-format
msgid "Install latest (%s)"
msgstr "Instalar la más reciente (%s)"

#: cmd/isotope/menu.go
msgid "Other releases"
msgstr "Otras versiones"

#: cmd/isotope/menu.go
msgid "Switch desktop"
msgstr "Cambiar de escritorio"

#: cmd/isotope/menu.go
msgid "Switch to the hardware image"
msgstr "Cambiar a la imagen para hardware"

#: cmd/isotope/menu.go
msgid "Switch to the virtual machine image"
msgstr "Cambiar a la imagen para máquina virtual"

#: cmd/isotope/menu.go
msgid "Install an image…"
msgstr "Instalar una imagen…"

#: cmd/isotope/menu.go
msgid "Cancel the update"
msgstr "Cancelar la actualización"

#: cmd/isotope/menu.go
msgid "Restart now"
msgstr "Reiniciar ahora"

#: cmd/isotope/menu.go
msgid "Extensions…"
msgstr "Extensiones…"

#: cmd/isotope/menu.go
msgid "Recovery key…"
msgstr "Clave de recuperación…"

#: cmd/isotope/menu.go
msgid "Restart into the previous system"
msgstr "Reiniciar en el sistema anterior"

#: cmd/isotope/tray.go
msgid "Isotope updates"
msgstr "Actualizaciones de Isotope"

#: cmd/isotope/trayapp.go
msgid "Update service not available"
msgstr "Servicio de actualizaciones no disponible"

#: cmd/isotope/trayapp.go
#, go-format
msgid "Isotope %s was installed in the background. It starts at the next restart."
msgstr "Isotope %s se instaló en segundo plano. Se iniciará en el próximo reinicio."

#: cmd/isotope/trayapp.go
#, go-format
msgid "Isotope %s was installed in the background. It starts at the next restart. Run `isotope reboot` to restart now."
msgstr "Isotope %s se instaló en segundo plano. Se iniciará en el próximo reinicio. Ejecute `isotope reboot` para reiniciar ahora."

#: cmd/isotope/trayapp.go
msgid "Restart to finish the update"
msgstr "Reinicie para terminar la actualización"

#: cmd/isotope/trayapp.go
msgid "Restart"
msgstr "Reiniciar"

#: cmd/isotope/trayapp.go
msgid "could not open Isotope System: %w"
msgstr "no se pudo abrir Isotope System: %w"

#: cmd/isotope/trayapp.go
msgid "the update service is not available"
msgstr "el servicio de actualizaciones no está disponible"

#: cmd/isotope/trayapp.go
msgid "Isotope update"
msgstr "Actualización de Isotope"

#: cmd/isotope/trayapp.go
msgid "unknown"
msgstr "desconocido"

#: cmd/isotope/trayapp.go
#, go-format
msgid "You are on %s. Install it from the update icon's menu in the panel."
msgstr "Está usando %s. Instálela desde el menú del icono de actualizaciones en el panel."

#: cmd/isotope/trayapp.go
#, go-format
msgid "You are on %s. Run `isotope upgrade` in a terminal to install it."
msgstr "Está usando %s. Ejecute `isotope upgrade` en una terminal para instalarla."

#: cmd/isotope/trayapp.go
msgid "no terminal to open: %s sets no TERMINAL_EXEC, and neither foot nor xterm is installed"
msgstr "no hay ningún terminal que abrir: %s no define TERMINAL_EXEC y no están instalados ni foot ni xterm"
