msgstr "App"

#: cmd/isotope-welcome/flow.go
#: cmd/isotope-welcome/page_shortcuts.go
msgid "Shortcuts"
msgstr "Scorciatoie"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Ready"
msgstr "Pronto"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Where"
msgstr "Dove"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Password"
msgstr "Password"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Backup"
msgstr "Backup"

#: cmd/isotope-welcome/flow.go
