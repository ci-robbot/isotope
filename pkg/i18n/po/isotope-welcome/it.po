#: cmd/isotope-welcome/backup.go
msgid "the secret is too long"
msgstr "il segreto è troppo lungo"

#: cmd/isotope-welcome/backup.go
msgid "REST server"
msgstr "Server REST"

#: cmd/isotope-welcome/backup.go
msgid "restic's rest-server, over HTTP or HTTPS"
msgstr "Il rest-server di restic, via HTTP o HTTPS"

#: cmd/isotope-welcome/backup.go
msgid "Amazon S3, or a service that works like it"
msgstr "Amazon S3, o un servizio che funziona allo stesso modo"

#: cmd/isotope-welcome/backup.go
msgid "A server you reach with SSH"
msgstr "Un server raggiungibile con SSH"

#: cmd/isotope-welcome/backup.go
msgid "The folder name has a control character."
msgstr "Il nome della cartella contiene un carattere di controllo."

#: cmd/isotope-welcome/backup.go
msgid "The folder cannot have . or .. in it."
msgstr "La cartella non può contenere . o .."

#: cmd/isotope-welcome/backup.go
msgid "Type the folder on the disk where the backup is."
msgstr "Scrivi la cartella del disco in cui si trova il backup."

#: cmd/isotope-welcome/backup.go
#, go-format
msgid "The value of %s has a line break in it."
msgstr "Il valore di %s contiene un a capo."

#: cmd/isotope-welcome/backup.go
msgid "Type the address of the server, starting with http:// or https://."
msgstr "Scrivi l'indirizzo del server, che inizia con http:// o https://."

#: cmd/isotope-welcome/backup.go
msgid "Put the user and the password in their fields, not in the address."
msgstr "Inserisci l'utente e la password nei rispettivi campi, non nell'indirizzo."

#: cmd/isotope-welcome/backup.go
msgid "Type the endpoint of the service, such as https://s3.amazonaws.com."
msgstr "Scrivi l'endpoint del servizio, ad esempio https://s3.amazonaws.com."

#: cmd/isotope-welcome/backup.go
msgid "Type the name of the bucket."
msgstr "Scrivi il nome del bucket."

#: cmd/isotope-welcome/backup.go
msgid "The path has a control character."
msgstr "Il percorso contiene un carattere di controllo."

#: cmd/isotope-welcome/backup.go
msgid "Type the access key ID and the secret access key."
msgstr "Scrivi l'ID della chiave di accesso e la chiave di accesso segreta."

#: cmd/isotope-welcome/backup.go
msgid "Type the user and the server as user@server."
msgstr "Scrivi l'utente e il server come utente@server."

#: cmd/isotope-welcome/backup.go
msgid "The port is a number from 1 to 65535."
msgstr "La porta è un numero da 1 a 65535."

#: cmd/isotope-welcome/backup.go
msgid "Type the folder on the server where the backup is."
msgstr "Scrivi la cartella del server in cui si trova il backup."

#: cmd/isotope-welcome/backup.go
msgid "Key"
msgstr "Chiave"

#: cmd/isotope-welcome/backup.go
#, go-format
msgid "%d bytes"
msgstr "%d byte"

#: cmd/isotope-welcome/backup.go
#, go-format
msgid "today at %s"
msgstr "oggi alle %s"

#: cmd/isotope-welcome/backup.go
#, go-format
msgid "yesterday at %s"
msgstr "ieri alle %s"

#: cmd/isotope-welcome/flow.go
msgid "Welcome"
msgstr "Benvenuto"

