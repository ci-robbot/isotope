msgid "Restore"
msgstr "Ripristino"

#: cmd/isotope-welcome/live.go
msgid "Help"
msgstr "Aiuto"

#: cmd/isotope-welcome/live.go
msgid "top bar"
msgstr "barra superiore"

#: cmd/isotope-welcome/live.go
msgid "Look around first. You can install at any time from the dock or the app launcher."
msgstr "Prima dai un'occhiata. Puoi installare quando vuoi dalla dock o dal launcher delle app."

#: cmd/isotope-welcome/live.go
msgid "Look around first. You can install at any time from the Isotope menu (Super+Esc) or the app list."
msgstr "Prima dai un'occhiata. Puoi installare quando vuoi dal menu di Isotope (Super+Esc) o dall'elenco delle app."

#: cmd/isotope-welcome/locale.go
msgid "Default (C.UTF-8)"
msgstr "Predefinita (C.UTF-8)"

#: cmd/isotope-welcome/main.go
#: cmd/isotope-welcome/page_live.go
#: cmd/isotope-welcome/page_welcome.go
msgid "Welcome to Isotope"
msgstr "Benvenuto in Isotope"

#: cmd/isotope-welcome/nm.go
msgid "Wrong password"
msgstr "Password errata"

#: cmd/isotope-welcome/nm.go
msgid "Could not connect to %s"
msgstr "Impossibile connettersi a %s"

#: cmd/isotope-welcome/nm.go
msgid "No Wi-Fi device"
msgstr "Nessun dispositivo Wi-Fi"

#: cmd/isotope-welcome/nm.go
msgid "Timed out connecting to %s"
msgstr "Tempo scaduto durante la connessione a %s"

#: cmd/isotope-welcome/notify.go
msgid "Apps installed"
msgstr "App installate"

#: cmd/isotope-welcome/notify.go
#, go-format
msgid "Installed: %s. Find them with the app launcher."
msgstr "Installate: %s. Le trovi nel launcher delle app."

#. TRANSLATORS: %[1]s and %[2]s are lists of app names; the end says where to find the apps again.
#: cmd/isotope-welcome/notify.go
msgid "Some apps did not install"
msgstr "Alcune app non sono state installate"

#. TRANSLATORS: %[1]s and %[2]s are lists of app names; the end says where to find the apps again.
#: cmd/isotope-welcome/notify.go
#, go-format
msgid "Installed: %[1]s. Failed: %[2]s. Open it later from the Isotope menu (Super+Esc → Welcome)."
msgstr "Installate: %[1]s. Non riuscite: %[2]s. Riaprilo più tardi dal menu di Isotope (Super+Esc → Welcome)."

#: cmd/isotope-welcome/notify.go
msgid "Apps did not install"
msgstr "Le app non sono state installate"

#: cmd/isotope-welcome/notify.go
#, go-format
msgid "Failed: %s. Open it later from the Isotope menu (Super+Esc → Welcome)."
msgstr "Non riuscite: %s. Riaprilo più tardi dal menu di Isotope (Super+Esc → Welcome)."

#: cmd/isotope-welcome/notify.go
msgctxt "verb"
msgid "Open"
msgstr "Apri"

#: cmd/isotope-welcome/notify.go
msgid "Install essential apps"
msgstr "Installa le app essenziali"

#: cmd/isotope-welcome/notify.go
msgid "Pick a few essential apps from Flathub, or install the ones that did not finish."
msgstr "Scegli alcune app essenziali da Flathub, o installa quelle che non sono state completate."

#: cmd/isotope-welcome/notify.go
msgid "Install a browser and essential apps"
msgstr "Installa un browser e le app essenziali"

#: cmd/isotope-welcome/notify.go
msgid "Isotope has no browser yet. Pick one and a few essentials from Flathub."
msgstr "Isotope non ha ancora un browser. Scegline uno e qualche app essenziale da Flathub."

#: cmd/isotope-welcome/page_access.go
msgid "Some X11 apps need a restart. i3 restarts at once to use it; your windows stay open."
msgstr "Alcune app X11 vanno riavviate. i3 si riavvia subito per applicarla; le finestre restano aperte."

#: cmd/isotope-welcome/page_access.go
msgid "Set for every screen connected now. A screen you plug in later keeps its own scale."
msgstr "Impostata per ogni schermo collegato ora. Uno schermo collegato in seguito mantiene la propria scala."

#: cmd/isotope-welcome/page_access.go
msgid "To make text bigger, choose a larger scale."
msgstr "Per ingrandire il testo, scegli una scala maggiore."

#: cmd/isotope-welcome/page_access.go
#, go-format
msgid "Could not change the display scale: %v"
msgstr "Impossibile cambiare la scala dello schermo: %v"

#: cmd/isotope-welcome/page_access.go
#, go-format
msgid "Could not change the text size: %v"
msgstr "Impossibile cambiare la dimensione del testo: %v"

#: cmd/isotope-welcome/page_access.go
msgid "Text in apps is a quarter larger. Apps follow at once."
msgstr "Il testo nelle app è più grande di un quarto. Le app si adeguano subito."

#: cmd/isotope-welcome/page_access.go
msgid "Text in GTK Flatpak apps is a quarter larger. For every app, choose a larger scale."
msgstr "Il testo nelle app Flatpak GTK è più grande di un quarto. Per tutte le app, scegli una scala maggiore."

#: cmd/isotope-welcome/page_access.go
msgid "Make the screen easier to read. Your choice applies now and stays for later logins."
msgstr "Rendi lo schermo più facile da leggere. La scelta si applica subito e resta per i prossimi accessi."

#: cmd/isotope-welcome/page_access.go
#: cmd/isotope-welcome/page_appearance.go
#: cmd/isotope-welcome/page_cosmic.go
msgid "Applying…"
msgstr "Applicazione in corso…"

#: cmd/isotope-welcome/page_access.go
msgid "Display scale"
msgstr "Scala dello schermo"

#: cmd/isotope-welcome/page_access.go
msgid "Default"
msgstr "Predefinita"

#: cmd/isotope-welcome/page_access.go
msgid "Larger text"
msgstr "Testo più grande"

#: cmd/isotope-welcome/page_appearance.go
msgid "Apps use a light theme; the bar and menus stay dark"
msgstr "Le app usano un tema chiaro; la barra e i menu restano scuri"

#: cmd/isotope-welcome/page_appearance.go
msgid "Light windows and panels"
msgstr "Finestre e pannelli chiari"

#: cmd/isotope-welcome/page_appearance.go
#, go-format
msgid "Could not change the appearance: %v"
msgstr "Impossibile cambiare l'aspetto: %v"

#: cmd/isotope-welcome/page_appearance.go
msgid "Dark is Isotope's look. You can change it later in the Isotope menu."
msgstr "Lo scuro è l'aspetto di Isotope. Puoi cambiarlo più tardi dal menu di Isotope."

#: cmd/isotope-welcome/page_appearance.go
msgid "Dark"
msgstr "Scuro"

#: cmd/isotope-welcome/page_appearance.go
msgid "Easy on the eyes, the Isotope look"
msgstr "Riposante per gli occhi, l'aspetto di Isotope"

#: cmd/isotope-welcome/page_appearance.go
msgid "Light"
msgstr "Chiaro"

#: cmd/isotope-welcome/page_apps.go
#: cmd/isotope-welcome/page_language.go
#: cmd/isotope-welcome/page_network.go
#: cmd/isotope-welcome/page_ready.go
msgid "Try again"
msgstr "Riprova"

#: cmd/isotope-welcome/page_apps.go
msgid "No network connection."
msgstr "Nessuna connessione di rete."

#: cmd/isotope-welcome/page_apps.go
msgid "Connect to a network and try again. If you skip, Isotope reminds you at your next login."
msgstr "Connettiti a una rete e riprova. Se salti, Isotope te lo ricorderà al prossimo accesso."

#: cmd/isotope-welcome/page_apps.go
msgid "Flathub is not ready."
msgstr "Flathub non è pronto."

#: cmd/isotope-welcome/page_apps.go
msgid "The Flathub remote is missing or disabled for your user. Try again later. If you skip, Isotope reminds you at your next login."
msgstr "Il remote Flathub manca o è disattivato per il tuo utente. Riprova più tardi. Se salti, Isotope te lo ricorderà al prossimo accesso."

#: cmd/isotope-welcome/page_apps.go
msgid "Install apps"
msgstr "Installa app"

#: cmd/isotope-welcome/page_apps.go
msgid "Checking the network and Flathub…"
msgstr "Verifica della rete e di Flathub in corso…"

#: cmd/isotope-welcome/page_apps.go
msgid "Isotope includes no browser. Its apps come from Flathub."
msgstr "Isotope non include un browser. Le sue app arrivano da Flathub."

#: cmd/isotope-welcome/page_apps.go
msgid "Installing apps"
msgstr "Installazione delle app"

#: cmd/isotope-welcome/page_apps.go
msgid "The apps install in the background. You can go on; Isotope tells you when they are done."
msgstr "Le app si installano in background. Puoi proseguire; Isotope ti avvisa quando hanno finito."

#. TRANSLATORS: %[1]s is an app's name; then its place in the batch and the number of apps.
#: cmd/isotope-welcome/page_apps.go
#, go-format
msgid "Installing %[1]s (%[2]d of %[3]d)"
msgstr "Installazione di %[1]s (%[2]d di %[3]d)"

#. TRANSLATORS: apps installed of the batch's apps.
#: cmd/isotope-welcome/page_apps.go
#, go-format
msgid "%[1]d of %[2]d installed"
msgstr "%[1]d di %[2]d installate"

#: cmd/isotope-welcome/page_apps.go
msgid "Isotope includes no browser. These apps come from Flathub and install for your user only."
msgstr "Isotope non include un browser. Queste app arrivano da Flathub e si installano solo per il tuo utente."

#: cmd/isotope-welcome/page_apps.go
#, go-format
msgid "Could not install %s. They are ticked: Continue tries again."
msgstr "Impossibile installare %s. Sono selezionate: Continua riprova."

#: cmd/isotope-welcome/page_apps.go
msgid "Essentials"
msgstr "Essenziali"

#: cmd/isotope-welcome/page_apps.go
msgid "Browser (pick one)"
msgstr "Browser (scegline uno)"

#: cmd/isotope-welcome/page_apps.go
msgid "No browser"
msgstr "Nessun browser"

#. TRANSLATORS: an app that is already installed.
#: cmd/isotope-welcome/page_apps.go
msgctxt "app"
msgid "Installed"
msgstr "Installata"

#: cmd/isotope-welcome/page_cosmic.go
#, go-format
msgid "Could not read the panel layouts: %v"
msgstr "Impossibile leggere i layout del pannello: %v"

#: cmd/isotope-welcome/page_cosmic.go
#, go-format
msgid "Could not change the layout: %v"
msgstr "Impossibile cambiare il layout: %v"

#: cmd/isotope-welcome/page_cosmic.go
msgid "Move the panel or dock to any edge, change their size, and automatically hide them in Settings."
msgstr "Sposta il pannello o la dock su qualsiasi bordo, cambiane la dimensione e nascondili automaticamente da Impostazioni."

#: cmd/isotope-welcome/page_cosmic.go
msgid "The panel restarts when you continue."
msgstr "Il pannello si riavvia quando continui."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Workspaces for your workflow"
msgstr "Spazi di lavoro per il tuo flusso di lavoro"

#: cmd/isotope-welcome/page_cosmic.go
msgid "Float or automatically tile windows per-workspace using the tiling applet."
msgstr "Finestre fluttuanti o affiancate automaticamente per ogni spazio di lavoro, con l'applet di tiling."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Vertical or horizontal"
msgstr "Verticali o orizzontali"

#: cmd/isotope-welcome/page_cosmic.go
msgid "You can select vertical or horizontal workspaces. You can also pin workspaces to make them static."
msgstr "Puoi scegliere spazi di lavoro verticali o orizzontali. Puoi anche fissarli per renderli statici."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Change these any time in COSMIC Settings. Nothing is set on this page."
msgstr "Puoi cambiarli quando vuoi nelle Impostazioni di COSMIC. Questa pagina non imposta nulla."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Fast and efficient"
msgstr "Veloce ed efficiente"

#: cmd/isotope-welcome/page_cosmic.go
msgid "Press the Super (or Windows) key to activate the Launcher. Search and press Enter to open an app or switch to it."
msgstr "Premi il tasto Super (o Windows) per attivare il Launcher. Cerca e premi Enter per aprire un'app o passare a essa."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Press Super"
msgstr "Premi Super"

#: cmd/isotope-welcome/page_cosmic.go
msgid "You can also jump to settings or system functions like suspend. Type “?” to learn about the Launcher's advanced features."
msgstr "Puoi anche passare alle impostazioni o a funzioni di sistema come la sospensione. Scrivi “?” per scoprire le funzioni avanzate del Launcher."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Nothing is set on this page."
msgstr "Questa pagina non imposta nulla."

#: cmd/isotope-welcome/page_language.go
msgid "Ask an administrator to change the language"
msgstr "Chiedi a un amministratore di cambiare la lingua"

#: cmd/isotope-welcome/page_language.go
#, go-format
msgid "Could not list the languages: %v"
msgstr "Impossibile elencare le lingue: %v"

#: cmd/isotope-welcome/page_language.go
msgid "Isotope could not list the languages."
msgstr "Isotope non è riuscito a elencare le lingue."

#: cmd/isotope-welcome/page_language.go
#: cmd/isotope-welcome/page_live.go
msgid "Not set"
msgstr "Non impostata"

#: cmd/isotope-welcome/page_language.go
msgid "The system language applies to every user of this computer."
msgstr "La lingua di sistema vale per tutti gli utenti di questo computer."

#: cmd/isotope-welcome/page_language.go
msgid "Current language"
msgstr "Lingua attuale"

#: cmd/isotope-welcome/page_language.go
msgid "The system language applies to every user of this computer. You can change it later in the Isotope menu."
msgstr "La lingua di sistema vale per tutti gli utenti di questo computer. Puoi cambiarla più tardi dal menu di Isotope."

#: cmd/isotope-welcome/page_language.go
#: cmd/isotope-welcome/page_live.go
msgid "Search languages"
msgstr "Cerca lingue"

#: cmd/isotope-welcome/page_language.go
msgid "Setting the language…"
msgstr "Impostazione della lingua in corso…"

#: cmd/isotope-welcome/page_live.go
msgid "New apps use this language. The installer uses it too."
msgstr "Le app avviate da ora usano questa lingua. Anche l'installer la usa."

#: cmd/isotope-welcome/page_live.go
msgid "Use this language"
msgstr "Usa questa lingua"

#: cmd/isotope-welcome/page_live.go
msgid "Keyboard layout"
msgstr "Layout della tastiera"

#: cmd/isotope-welcome/page_live.go
msgid "The layout changes at once. The installer uses it too."
msgstr "Il layout cambia subito. Anche l'installer lo usa."

#: cmd/isotope-welcome/page_live.go
msgid "Search layouts"
msgstr "Cerca layout"

#: cmd/isotope-welcome/page_live.go
msgid "Use this layout"
msgstr "Usa questo layout"

#: cmd/isotope-welcome/page_live.go
msgid "The installer is not available."
msgstr "L'installer non è disponibile."

#: cmd/isotope-welcome/page_live.go
#, go-format
msgid "Could not start the installer: %v"
msgstr "Impossibile avviare l'installer: %v"

#: cmd/isotope-welcome/page_live.go
#: cmd/isotope-welcome/page_restore.go
msgid "Cancel"
msgstr "Annulla"

#: cmd/isotope-welcome/page_live.go
#, go-format
msgid "Could not save the choice for the installer: %v"
msgstr "Impossibile salvare la scelta per l'installer: %v"

#: cmd/isotope-welcome/page_live.go
#, go-format
msgid "Could not apply it to this session: %v"
msgstr "Impossibile applicarla a questa sessione: %v"

#: cmd/isotope-welcome/page_live.go
msgid "You are running Isotope from the USB stick. Nothing on this computer changes until you install it."
msgstr "Stai usando Isotope dalla chiavetta USB. Su questo computer non cambia nulla finché non lo installi."

#: cmd/isotope-welcome/page_live.go
msgid "Changes in this session are lost when you shut down."
msgstr "Le modifiche fatte in questa sessione si perdono allo spegnimento."

#: cmd/isotope-welcome/page_live.go
msgid "Install Isotope"
msgstr "Installa Isotope"

#: cmd/isotope-welcome/page_live.go
msgid "Put Isotope on this computer's disk. It takes a few minutes."
msgstr "Metti Isotope sul disco di questo computer. Ci vuole qualche minuto."

#: cmd/isotope-welcome/page_live.go
msgid "Try it out"
msgstr "Provalo"

#: cmd/isotope-welcome/page_live.go
msgid "Keyboard"
msgstr "Tastiera"

#: cmd/isotope-welcome/page_network.go
#, go-format
msgid "Could not reach NetworkManager: %v"
msgstr "Impossibile contattare NetworkManager: %v"

#: cmd/isotope-welcome/page_network.go
msgid "Enter the network name"
msgstr "Inserisci il nome della rete"

#: cmd/isotope-welcome/page_network.go
msgid "Enter the password"
msgstr "Inserisci la password"

#: cmd/isotope-welcome/page_network.go
msgid "Connected"
msgstr "Connesso"

#: cmd/isotope-welcome/page_network.go
#, go-format
msgid "Connected to %s"
msgstr "Connesso a %s"

#: cmd/isotope-welcome/page_network.go
msgid "You are online. Apps and updates can use the connection."
msgstr "Sei online. Le app e gli aggiornamenti possono usare la connessione."

#: cmd/isotope-welcome/page_network.go
msgid "Plug in a network cable, or continue without a network."
msgstr "Collega un cavo di rete, o continua senza rete."

#: cmd/isotope-welcome/page_network.go
msgid "Isotope could not look for networks."
msgstr "Isotope non è riuscito a cercare le reti."

#: cmd/isotope-welcome/page_network.go
msgid "Looking for networks…"
msgstr "Ricerca delle reti…"

#: cmd/isotope-welcome/page_network.go
msgid "Pick a Wi-Fi network. You can also continue without one."
msgstr "Scegli una rete Wi-Fi. Puoi anche continuare senza."

#: cmd/isotope-welcome/page_network.go
msgid "Show the list of networks"
msgstr "Mostra l'elenco delle reti"

#: cmd/isotope-welcome/page_network.go
msgid "No Wi-Fi networks found."
msgstr "Nessuna rete Wi-Fi trovata."

#: cmd/isotope-welcome/page_network.go
msgid "Hidden network…"
msgstr "Rete nascosta…"

#: cmd/isotope-welcome/page_network.go
msgid "Scan again"
msgstr "Cerca di nuovo"

#: cmd/isotope-welcome/page_network.go
msgid "Secured"
msgstr "Protetta"

#: cmd/isotope-welcome/page_network.go
#: cmd/isotope-welcome/page_restore.go
msgid "Password"
msgstr "Password"

#: cmd/isotope-welcome/page_network.go
#: cmd/isotope-welcome/page_restore.go
msgid "Connect"
msgstr "Connetti"

#: cmd/isotope-welcome/page_network.go
msgid "Connecting…"
msgstr "Connessione in corso…"

#: cmd/isotope-welcome/page_network.go
msgid "Network name"
msgstr "Nome della rete"

#: cmd/isotope-welcome/page_network.go
msgid "Leave empty for an open network."
msgstr "Lascia vuoto per una rete aperta."

#: cmd/isotope-welcome/page_ready.go
msgid "Finish"
msgstr "Fine"

#: cmd/isotope-welcome/page_ready.go
#, go-format
msgid "Could not log out: %v. Log out from the power menu instead."
msgstr "Impossibile uscire dalla sessione: %v. Esci dal menu di spegnimento."

#: cmd/isotope-welcome/page_ready.go
msgid "Isotope is ready"
msgstr "Isotope è pronto"

#: cmd/isotope-welcome/page_ready.go
msgid "You can open this again from the Isotope menu (Super+Esc → Welcome)."
msgstr "Puoi riaprire questa finestra dal menu di Isotope (Super+Esc → Welcome)."

#: cmd/isotope-welcome/page_ready.go
#, go-format
msgid "Could not install %s."
msgstr "Impossibile installare %s."

#: cmd/isotope-welcome/page_ready.go
#, go-format
msgid "Log out to use %s"
msgstr "Esci dalla sessione per usare %s"

#: cmd/isotope-welcome/page_ready.go
msgid "The desktop and apps change language when you sign in again."
