msgid "Looking for USB disks…"
msgstr "Ricerca dei dischi USB in corso…"

#: cmd/isotope-welcome/page_restore.go
msgid "Plug in the USB disk with the backup, then click Look again."
msgstr "Collega il disco USB con il backup, poi fai clic su Cerca di nuovo."

#: cmd/isotope-welcome/page_restore.go
msgid "Look again"
msgstr "Cerca di nuovo"

#: cmd/isotope-welcome/page_restore.go
msgid "Folder"
msgstr "Cartella"

#: cmd/isotope-welcome/page_restore.go
