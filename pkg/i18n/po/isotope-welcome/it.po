msgid "Such as https://s3.amazonaws.com"
msgstr "Ad esempio https://s3.amazonaws.com"

#: cmd/isotope-welcome/page_restore.go
msgid "Bucket"
msgstr "Bucket"

#: cmd/isotope-welcome/page_restore.go
msgid "Path"
msgstr "Percorso"

#: cmd/isotope-welcome/page_restore.go
msgid "In the bucket. Optional."
msgstr "Nel bucket. Facoltativo."

#: cmd/isotope-welcome/page_restore.go
msgid "Access key ID"
msgstr "ID della chiave di accesso"

#: cmd/isotope-welcome/page_restore.go
msgid "Secret access key"
msgstr "Chiave di accesso segreta"

#: cmd/isotope-welcome/page_restore.go
msgid "Region"
msgstr "Regione"

#: cmd/isotope-welcome/page_restore.go
msgid "Optional."
msgstr "Facoltativo."

#: cmd/isotope-welcome/page_restore.go
msgid "User and server"
msgstr "Utente e server"

#: cmd/isotope-welcome/page_restore.go
msgid "Such as anna@nas.local"
msgstr "Ad esempio anna@nas.local"

#: cmd/isotope-welcome/page_restore.go
msgid "Port"
msgstr "Porta"

#: cmd/isotope-welcome/page_restore.go
msgid "Folder on the server"
msgstr "Cartella sul server"

#: cmd/isotope-welcome/page_restore.go
msgid "Such as /srv/backup"
msgstr "Ad esempio /srv/backup"

#: cmd/isotope-welcome/page_restore.go
msgid "Reading the backup's SSH key…"
msgstr "Lettura della chiave SSH del backup…"

#: cmd/isotope-welcome/page_restore.go
msgid "Add this key to the server's authorized_keys, then Connect."
msgstr "Aggiungi questa chiave al file authorized_keys del server, poi fai clic su Connetti."

#: cmd/isotope-welcome/page_restore.go
msgid "Copy"
msgstr "Copia"

#: cmd/isotope-welcome/page_restore.go
msgid "Copied."
msgstr "Copiata."

#: cmd/isotope-welcome/page_restore.go
msgid "Fetching the server's keys…"
msgstr "Recupero delle chiavi del server in corso…"

#. TRANSLATORS: %s is the server and its port ("nas.local:22").
#: cmd/isotope-welcome/page_restore.go
#, go-format
msgid "%s sent these keys. On the server, ssh-keygen -lf /etc/ssh/ssh_host_*_key.pub shows its own, with their type. Choose the key you compared, and confirm it only when it is the same."
msgstr "%s ha inviato queste chiavi. Sul server, ssh-keygen -lf /etc/ssh/ssh_host_*_key.pub mostra le sue, con il tipo. Scegli la chiave che hai confrontato e confermala solo se è la stessa."

#: cmd/isotope-welcome/page_restore.go
msgid "This is the server's key"
msgstr "Questa è la chiave del server"

#: cmd/isotope-welcome/page_restore.go
#, go-format
msgid "Key of %[1]s confirmed: %[2]s"
msgstr "Chiave di %[1]s confermata: %[2]s"

#: cmd/isotope-welcome/page_restore.go
msgid "Where is the backup?"
msgstr "Dove si trova il backup?"

#: cmd/isotope-welcome/page_restore.go
msgid "A USB disk, or the server this machine backed up to."
msgstr "Un disco USB, o il server su cui questa macchina ha fatto il backup."

#: cmd/isotope-welcome/page_restore.go
msgid "Find the backups"
msgstr "Trova i backup"

#: cmd/isotope-welcome/page_restore.go
msgid "The password shown when the backup was set up. For a key shown by Isotope, spaces and capitals do not matter."
msgstr "La password mostrata quando è stato configurato il backup. Per una chiave mostrata da Isotope, spazi e maiuscole non contano."

#: cmd/isotope-welcome/page_restore.go
#, go-format
msgid "Reading the backups in %s…"
msgstr "Lettura dei backup in %s…"

#: cmd/isotope-welcome/page_restore.go
msgid "The backup's password"
msgstr "La password del backup"

#: cmd/isotope-welcome/page_restore.go
#, go-format
msgid "Type the password of the backup in %s."
msgstr "Scrivi la password del backup in %s."

#: cmd/isotope-welcome/page_restore.go
msgid "Restore…"
msgstr "Ripristina…"

#: cmd/isotope-welcome/page_restore.go
#, go-format
msgid "Backup %s"
msgstr "Backup %s"

#: cmd/isotope-welcome/page_restore.go
msgid "Which backup?"
msgstr "Quale backup?"

#: cmd/isotope-welcome/page_restore.go
msgid "The backups there, by computer, the newest first."
msgstr "I backup presenti, per computer, dal più recente."

#: cmd/isotope-welcome/page_restore.go
msgid "The restore did not start"
msgstr "Il ripristino non è partito"

#: cmd/isotope-welcome/page_restore.go
msgid "Nothing on this machine changed."
msgstr "Su questa macchina non è cambiato nulla."

#: cmd/isotope-welcome/page_restore.go
msgid "The restore failed"
msgstr "Il ripristino non è riuscito"

#: cmd/isotope-welcome/page_restore.go
msgid "Parts of the backup may already be on this machine, and it may restart. If it does not, restart it and check your files; to try again, use isotope restore in a terminal."
msgstr "Parti del backup potrebbero essere già su questa macchina, che potrebbe riavviarsi. Se non lo fa, riavviala e controlla i tuoi file; per riprovare, usa isotope restore in un terminale."

#: cmd/isotope-welcome/page_restore.go
msgid "Restarting"
msgstr "Riavvio in corso"

#: cmd/isotope-welcome/page_restore.go
msgid "The backup is back. The machine restarts now; after the restart it installs the apps and extensions again."
msgstr "Il backup è stato ripristinato. La macchina si riavvia ora; dopo il riavvio installa di nuovo le app e le estensioni."

#: cmd/isotope-welcome/page_restore.go
msgid "Restoring the backup"
msgstr "Ripristino del backup in corso"

#: cmd/isotope-welcome/page_restore.go
msgid "This can take a long time. Leave the computer on: it restarts when the restore is done."
msgstr "Può richiedere molto tempo. Lascia acceso il computer: si riavvia al termine del ripristino."

#: cmd/isotope-welcome/page_restore.go
msgid "Starting the restore"
msgstr "Avvio del ripristino"

#: cmd/isotope-welcome/page_restore.go
msgid "Asking the update service…"
msgstr "Richiesta al servizio di aggiornamento in corso…"

#: cmd/isotope-welcome/page_shortcuts.go
#, go-format
msgid "The shortcut sheet did not open: %v"
msgstr "Impossibile aprire la scheda delle scorciatoie: %v"

#: cmd/isotope-welcome/page_shortcuts.go
msgid "Isotope is made to be used from the keyboard. Super is the key with the Windows logo. These keys work in every app."
msgstr "Isotope è fatto per essere usato dalla tastiera. Super è il tasto con il logo di Windows. Questi tasti funzionano in ogni app."

#: cmd/isotope-welcome/page_shortcuts.go
msgid "Show all shortcuts"
msgstr "Mostra tutte le scorciatoie"

