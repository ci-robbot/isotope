msgstr "Flujo de trabajo"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Launcher"
msgstr "Lanzador"

#: cmd/isotope-welcome/flow.go
#: cmd/isotope-welcome/page_access.go
msgid "Accessibility"
msgstr "Accesibilidad"

#: cmd/isotope-welcome/flow.go
#: cmd/isotope-welcome/live.go
msgid "Apps"
msgstr "Aplicaciones"

#: cmd/isotope-welcome/flow.go
#: cmd/isotope-welcome/page_shortcuts.go
msgid "Shortcuts"
msgstr "Atajos"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Ready"
msgstr "Listo"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Where"
msgstr "Ubicación"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Password"
msgstr "Contraseña"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Backup"
msgstr "Copia"

#: cmd/isotope-welcome/flow.go
msgctxt "page"
msgid "Restore"
msgstr "Restauración"

#: cmd/isotope-welcome/live.go
msgid "Help"
msgstr "Ayuda"

#: cmd/isotope-welcome/live.go
msgid "top bar"
msgstr "barra superior"

#: cmd/isotope-welcome/live.go
msgid "Look around first. You can install at any time from the dock or the app launcher."
msgstr "Eche un vistazo primero. Puede instalar en cualquier momento desde el dock o el lanzador de aplicaciones."

#: cmd/isotope-welcome/live.go
msgid "Look around first. You can install at any time from the Isotope menu (Super+Esc) or the app list."
msgstr "Eche un vistazo primero. Puede instalar en cualquier momento desde el menú de Isotope (Super+Esc) o la lista de aplicaciones."

#: cmd/isotope-welcome/locale.go
msgid "Default (C.UTF-8)"
msgstr "Predeterminado (C.UTF-8)"

#: cmd/isotope-welcome/main.go
#: cmd/isotope-welcome/page_live.go
#: cmd/isotope-welcome/page_welcome.go
msgid "Welcome to Isotope"
msgstr "Bienvenido a Isotope"

#: cmd/isotope-welcome/nm.go
msgid "Wrong password"
msgstr "Contraseña incorrecta"

#: cmd/isotope-welcome/nm.go
msgid "Could not connect to %s"
msgstr "No se pudo conectar con %s"

#: cmd/isotope-welcome/nm.go
msgid "No Wi-Fi device"
msgstr "No hay ningún dispositivo Wi-Fi"

#: cmd/isotope-welcome/nm.go
msgid "Timed out connecting to %s"
msgstr "Se agotó el tiempo al conectar con %s"

#: cmd/isotope-welcome/notify.go
msgid "Apps installed"
msgstr "Aplicaciones instaladas"

#: cmd/isotope-welcome/notify.go
#, go-format
msgid "Installed: %s. Find them with the app launcher."
msgstr "Instaladas: %s. Puede encontrarlas en el lanzador de aplicaciones."

#. TRANSLATORS: %[1]s and %[2]s are lists of app names; the end says where to find the apps again.
#: cmd/isotope-welcome/notify.go
msgid "Some apps did not install"
msgstr "Algunas aplicaciones no se instalaron"

#. TRANSLATORS: %[1]s and %[2]s are lists of app names; the end says where to find the apps again.
#: cmd/isotope-welcome/notify.go
#, go-format
msgid "Installed: %[1]s. Failed: %[2]s. Open it later from the Isotope menu (Super+Esc → Welcome)."
msgstr "Instaladas: %[1]s. Fallaron: %[2]s. Ábralo más tarde desde el menú de Isotope (Super+Esc → Welcome)."

#: cmd/isotope-welcome/notify.go
msgid "Apps did not install"
msgstr "Las aplicaciones no se instalaron"

#: cmd/isotope-welcome/notify.go
#, go-format
msgid "Failed: %s. Open it later from the Isotope menu (Super+Esc → Welcome)."
msgstr "Fallaron: %s. Ábralo más tarde desde el menú de Isotope (Super+Esc → Welcome)."

#: cmd/isotope-welcome/notify.go
msgctxt "verb"
msgid "Open"
msgstr "Abrir"

#: cmd/isotope-welcome/notify.go
msgid "Install essential apps"
msgstr "Instalar las aplicaciones esenciales"

#: cmd/isotope-welcome/notify.go
msgid "Pick a few essential apps from Flathub, or install the ones that did not finish."
msgstr "Elija algunas aplicaciones esenciales de Flathub, o instale las que no terminaron."

#: cmd/isotope-welcome/notify.go
msgid "Install a browser and essential apps"
msgstr "Instalar un navegador y las aplicaciones esenciales"

#: cmd/isotope-welcome/notify.go
msgid "Isotope has no browser yet. Pick one and a few essentials from Flathub."
msgstr "Isotope todavía no tiene navegador. Elija uno y algunas aplicaciones esenciales de Flathub."

#: cmd/isotope-welcome/page_access.go
msgid "Some X11 apps need a restart. i3 restarts at once to use it; your windows stay open."
msgstr "Algunas aplicaciones X11 necesitan reiniciarse. i3 se reinicia al momento para usarla; sus ventanas siguen abiertas."

#: cmd/isotope-welcome/page_access.go
msgid "Set for every screen connected now. A screen you plug in later keeps its own scale."
msgstr "Se aplica a cada pantalla conectada ahora. Una pantalla que conecte después conserva su propia escala."

#: cmd/isotope-welcome/page_access.go
msgid "To make text bigger, choose a larger scale."
msgstr "Para agrandar el texto, elija una escala mayor."

#: cmd/isotope-welcome/page_access.go
#, go-format
msgid "Could not change the display scale: %v"
msgstr "No se pudo cambiar la escala de la pantalla: %v"

#: cmd/isotope-welcome/page_access.go
#, go-format
msgid "Could not change the text size: %v"
msgstr "No se pudo cambiar el tamaño del texto: %v"

#: cmd/isotope-welcome/page_access.go
msgid "Text in apps is a quarter larger. Apps follow at once."
msgstr "El texto de las aplicaciones es un cuarto más grande. Las aplicaciones lo aplican al momento."

#: cmd/isotope-welcome/page_access.go
msgid "Text in GTK Flatpak apps is a quarter larger. For every app, choose a larger scale."
msgstr "El texto de las aplicaciones Flatpak GTK es un cuarto más grande. Para todas las aplicaciones, elija una escala mayor."

#: cmd/isotope-welcome/page_access.go
msgid "Make the screen easier to read. Your choice applies now and stays for later logins."
msgstr "Haga la pantalla más fácil de leer. Su elección se aplica ahora y se mantiene en los próximos inicios de sesión."

#: cmd/isotope-welcome/page_access.go
#: cmd/isotope-welcome/page_appearance.go
#: cmd/isotope-welcome/page_cosmic.go
msgid "Applying…"
msgstr "Aplicando…"

#: cmd/isotope-welcome/page_access.go
msgid "Display scale"
msgstr "Escala de la pantalla"

#: cmd/isotope-welcome/page_access.go
msgid "Default"
msgstr "Predeterminada"

#: cmd/isotope-welcome/page_access.go
msgid "Larger text"
msgstr "Texto más grande"

#: cmd/isotope-welcome/page_appearance.go
msgid "Apps use a light theme; the bar and menus stay dark"
msgstr "Las aplicaciones usan un tema claro; la barra y los menús siguen oscuros"

#: cmd/isotope-welcome/page_appearance.go
msgid "Light windows and panels"
msgstr "Ventanas y paneles claros"

#: cmd/isotope-welcome/page_appearance.go
#, go-format
msgid "Could not change the appearance: %v"
msgstr "No se pudo cambiar la apariencia: %v"

#: cmd/isotope-welcome/page_appearance.go
msgid "Dark is Isotope's look. You can change it later in the Isotope menu."
msgstr "El oscuro es el aspecto de Isotope. Puede cambiarlo más tarde en el menú de Isotope."

#: cmd/isotope-welcome/page_appearance.go
msgid "Dark"
msgstr "Oscuro"

#: cmd/isotope-welcome/page_appearance.go
msgid "Easy on the eyes, the Isotope look"
msgstr "Descansado para la vista, el aspecto de Isotope"

#: cmd/isotope-welcome/page_appearance.go
msgid "Light"
msgstr "Claro"

#: cmd/isotope-welcome/page_apps.go
#: cmd/isotope-welcome/page_language.go
#: cmd/isotope-welcome/page_network.go
#: cmd/isotope-welcome/page_ready.go
msgid "Try again"
msgstr "Volver a intentarlo"

#: cmd/isotope-welcome/page_apps.go
msgid "No network connection."
msgstr "No hay conexión de red."

#: cmd/isotope-welcome/page_apps.go
msgid "Connect to a network and try again. If you skip, Isotope reminds you at your next login."
msgstr "Conéctese a una red y vuelva a intentarlo. Si lo omite, Isotope se lo recordará en el próximo inicio de sesión."

#: cmd/isotope-welcome/page_apps.go
msgid "Flathub is not ready."
msgstr "Flathub no está listo."

#: cmd/isotope-welcome/page_apps.go
msgid "The Flathub remote is missing or disabled for your user. Try again later. If you skip, Isotope reminds you at your next login."
msgstr "El remoto Flathub falta o está desactivado para su usuario. Vuelva a intentarlo más tarde. Si lo omite, Isotope se lo recordará en el próximo inicio de sesión."

#: cmd/isotope-welcome/page_apps.go
msgid "Install apps"
msgstr "Instalar aplicaciones"

#: cmd/isotope-welcome/page_apps.go
msgid "Checking the network and Flathub…"
msgstr "Comprobando la red y Flathub…"

#: cmd/isotope-welcome/page_apps.go
msgid "Isotope includes no browser. Its apps come from Flathub."
msgstr "Isotope no incluye ningún navegador. Sus aplicaciones vienen de Flathub."

#: cmd/isotope-welcome/page_apps.go
msgid "Installing apps"
msgstr "Instalando aplicaciones"

#: cmd/isotope-welcome/page_apps.go
msgid "The apps install in the background. You can go on; Isotope tells you when they are done."
msgstr "Las aplicaciones se instalan en segundo plano. Puede continuar; Isotope le avisará cuando terminen."

#. TRANSLATORS: %[1]s is an app's name; then its place in the batch and the number of apps.
#: cmd/isotope-welcome/page_apps.go
#, go-format
msgid "Installing %[1]s (%[2]d of %[3]d)"
msgstr "Instalando %[1]s (%[2]d de %[3]d)"

#. TRANSLATORS: apps installed of the batch's apps.
#: cmd/isotope-welcome/page_apps.go
#, go-format
msgid "%[1]d of %[2]d installed"
msgstr "%[1]d de %[2]d instaladas"

#: cmd/isotope-welcome/page_apps.go
msgid "Isotope includes no browser. These apps come from Flathub and install for your user only."
msgstr "Isotope no incluye ningún navegador. Estas aplicaciones vienen de Flathub y se instalan solo para su usuario."

#: cmd/isotope-welcome/page_apps.go
#, go-format
msgid "Could not install %s. They are ticked: Continue tries again."
msgstr "No se pudo instalar %s. Están marcadas: Continuar vuelve a intentarlo."

#: cmd/isotope-welcome/page_apps.go
msgid "Essentials"
msgstr "Esenciales"

#: cmd/isotope-welcome/page_apps.go
msgid "Browser (pick one)"
msgstr "Navegador (elija uno)"

#: cmd/isotope-welcome/page_apps.go
msgid "No browser"
msgstr "Ningún navegador"

#. TRANSLATORS: an app that is already installed.
#: cmd/isotope-welcome/page_apps.go
msgctxt "app"
msgid "Installed"
msgstr "Instalada"

#: cmd/isotope-welcome/page_cosmic.go
#, go-format
msgid "Could not read the panel layouts: %v"
msgstr "No se pudieron leer los diseños del panel: %v"

#: cmd/isotope-welcome/page_cosmic.go
#, go-format
msgid "Could not change the layout: %v"
msgstr "No se pudo cambiar el diseño: %v"

#: cmd/isotope-welcome/page_cosmic.go
msgid "Move the panel or dock to any edge, change their size, and automatically hide them in Settings."
msgstr "Mueva el panel o el dock a cualquier borde, cambie su tamaño y ocúltelos automáticamente en Configuración."

#: cmd/isotope-welcome/page_cosmic.go
msgid "The panel restarts when you continue."
msgstr "El panel se reinicia al continuar."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Workspaces for your workflow"
msgstr "Espacios de trabajo para su flujo de trabajo"

#: cmd/isotope-welcome/page_cosmic.go
msgid "Float or automatically tile windows per-workspace using the tiling applet."
msgstr "Ventanas flotantes o en mosaico automático por espacio de trabajo, con el applet de mosaico."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Vertical or horizontal"
msgstr "Verticales u horizontales"

#: cmd/isotope-welcome/page_cosmic.go
msgid "You can select vertical or horizontal workspaces. You can also pin workspaces to make them static."
msgstr "Puede elegir espacios de trabajo verticales u horizontales. También puede fijarlos para que sean estáticos."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Change these any time in COSMIC Settings. Nothing is set on this page."
msgstr "Puede cambiarlos cuando quiera en la Configuración de COSMIC. Esta página no configura nada."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Fast and efficient"
msgstr "Rápido y eficiente"

#: cmd/isotope-welcome/page_cosmic.go
msgid "Press the Super (or Windows) key to activate the Launcher. Search and press Enter to open an app or switch to it."
msgstr "Pulse la tecla Super (o Windows) para activar el lanzador. Busque y pulse Enter para abrir una aplicación o cambiar a ella."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Press Super"
msgstr "Pulse Super"

#: cmd/isotope-welcome/page_cosmic.go
msgid "You can also jump to settings or system functions like suspend. Type “?” to learn about the Launcher's advanced features."
msgstr "También puede ir a la configuración o a funciones del sistema como suspender. Escriba “?” para conocer las funciones avanzadas del lanzador."

#: cmd/isotope-welcome/page_cosmic.go
msgid "Nothing is set on this page."
msgstr "Esta página no configura nada."

#: cmd/isotope-welcome/page_language.go
msgid "Ask an administrator to change the language"
msgstr "Pida a un administrador que cambie el idioma"

#: cmd/isotope-welcome/page_language.go
#, go-format
msgid "Could not list the languages: %v"
msgstr "No se pudieron enumerar los idiomas: %v"

#: cmd/isotope-welcome/page_language.go
msgid "Isotope could not list the languages."
msgstr "Isotope no pudo enumerar los idiomas."

#: cmd/isotope-welcome/page_language.go
#: cmd/isotope-welcome/page_live.go
msgid "Not set"
msgstr "Sin definir"

#: cmd/isotope-welcome/page_language.go
msgid "The system language applies to every user of this computer."
msgstr "El idioma del sistema se aplica a todos los usuarios de este equipo."

#: cmd/isotope-welcome/page_language.go
msgid "Current language"
msgstr "Idioma actual"

#: cmd/isotope-welcome/page_language.go
msgid "The system language applies to every user of this computer. You can change it later in the Isotope menu."
msgstr "El idioma del sistema se aplica a todos los usuarios de este equipo. Puede cambiarlo más tarde en el menú de Isotope."

#: cmd/isotope-welcome/page_language.go
#: cmd/isotope-welcome/page_live.go
msgid "Search languages"
msgstr "Buscar idiomas"

#: cmd/isotope-welcome/page_language.go
msgid "Setting the language…"
msgstr "Configurando el idioma…"

#: cmd/isotope-welcome/page_live.go
msgid "New apps use this language. The installer uses it too."
msgstr "Las aplicaciones nuevas usan este idioma. El instalador también lo usa."

#: cmd/isotope-welcome/page_live.go
msgid "Use this language"
msgstr "Usar este idioma"

#: cmd/isotope-welcome/page_live.go
msgid "Keyboard layout"
msgstr "Distribución del teclado"

#: cmd/isotope-welcome/page_live.go
msgid "The layout changes at once. The installer uses it too."
msgstr "La distribución cambia al momento. El instalador también la usa."

#: cmd/isotope-welcome/page_live.go
msgid "Search layouts"
msgstr "Buscar distribuciones"

#: cmd/isotope-welcome/page_live.go
msgid "Use this layout"
msgstr "Usar esta distribución"

#: cmd/isotope-welcome/page_live.go
msgid "The installer is not available."
msgstr "El instalador no está disponible."

#: cmd/isotope-welcome/page_live.go
#, go-format
msgid "Could not start the installer: %v"
msgstr "No se pudo iniciar el instalador: %v"

#: cmd/isotope-welcome/page_live.go
#: cmd/isotope-welcome/page_restore.go
msgid "Cancel"
msgstr "Cancelar"

#: cmd/isotope-welcome/page_live.go
#, go-format
msgid "Could not save the choice for the installer: %v"
msgstr "No se pudo guardar la elección para el instalador: %v"

#: cmd/isotope-welcome/page_live.go
#, go-format
msgid "Could not apply it to this session: %v"
msgstr "No se pudo aplicar a esta sesión: %v"

#: cmd/isotope-welcome/page_live.go
msgid "You are running Isotope from the USB stick. Nothing on this computer changes until you install it."
msgstr "Está usando Isotope desde la memoria USB. Nada cambia en este equipo hasta que lo instale."

#: cmd/isotope-welcome/page_live.go
msgid "Changes in this session are lost when you shut down."
msgstr "Los cambios de esta sesión se pierden al apagar."

#: cmd/isotope-welcome/page_live.go
msgid "Install Isotope"
msgstr "Instalar Isotope"

#: cmd/isotope-welcome/page_live.go
msgid "Put Isotope on this computer's disk. It takes a few minutes."
msgstr "Ponga Isotope en el disco de este equipo. Tarda unos minutos."

#: cmd/isotope-welcome/page_live.go
msgid "Try it out"
msgstr "Probarlo"

#: cmd/isotope-welcome/page_live.go
msgid "Keyboard"
msgstr "Teclado"

#: cmd/isotope-welcome/page_network.go
#, go-format
msgid "Could not reach NetworkManager: %v"
msgstr "No se pudo contactar con NetworkManager: %v"

#: cmd/isotope-welcome/page_network.go
msgid "Enter the network name"
msgstr "Escriba el nombre de la red"

#: cmd/isotope-welcome/page_network.go
msgid "Enter the password"
msgstr "Escriba la contraseña"

#: cmd/isotope-welcome/page_network.go
msgid "Connected"
msgstr "Conectado"

#: cmd/isotope-welcome/page_network.go
#, go-format
msgid "Connected to %s"
msgstr "Conectado a %s"

#: cmd/isotope-welcome/page_network.go
msgid "You are online. Apps and updates can use the connection."
msgstr "Está en línea. Las aplicaciones y las actualizaciones pueden usar la conexión."

#: cmd/isotope-welcome/page_network.go
msgid "Plug in a network cable, or continue without a network."
msgstr "Conecte un cable de red, o continúe sin red."

#: cmd/isotope-welcome/page_network.go
msgid "Isotope could not look for networks."
msgstr "Isotope no pudo buscar redes."

#: cmd/isotope-welcome/page_network.go
msgid "Looking for networks…"
msgstr "Buscando redes…"

#: cmd/isotope-welcome/page_network.go
msgid "Pick a Wi-Fi network. You can also continue without one."
msgstr "Elija una red Wi-Fi. También puede continuar sin ninguna."

#: cmd/isotope-welcome/page_network.go
msgid "Show the list of networks"
msgstr "Mostrar la lista de redes"

#: cmd/isotope-welcome/page_network.go
msgid "No Wi-Fi networks found."
msgstr "No se encontraron redes Wi-Fi."

#: cmd/isotope-welcome/page_network.go
msgid "Hidden network…"
msgstr "Red oculta…"

#: cmd/isotope-welcome/page_network.go
msgid "Scan again"
msgstr "Volver a buscar"

#: cmd/isotope-welcome/page_network.go
msgid "Secured"
msgstr "Protegida"

#: cmd/isotope-welcome/page_network.go
#: cmd/isotope-welcome/page_restore.go
msgid "Password"
msgstr "Contraseña"

#: cmd/isotope-welcome/page_network.go
#: cmd/isotope-welcome/page_restore.go
msgid "Connect"
msgstr "Conectar"

#: cmd/isotope-welcome/page_network.go
msgid "Connecting…"
msgstr "Conectando…"

#: cmd/isotope-welcome/page_network.go
msgid "Network name"
msgstr "Nombre de la red"

#: cmd/isotope-welcome/page_network.go
msgid "Leave empty for an open network."
msgstr "Déjelo vacío para una red abierta."

#: cmd/isotope-welcome/page_ready.go
msgid "Finish"
msgstr "Finalizar"

#: cmd/isotope-welcome/page_ready.go
#, go-format
msgid "Could not log out: %v. Log out from the power menu instead."
msgstr "No se pudo cerrar la sesión: %v. Ciérrela desde el menú de apagado."

#: cmd/isotope-welcome/page_ready.go
msgid "Isotope is ready"
msgstr "Isotope está listo"

#: cmd/isotope-welcome/page_ready.go
msgid "You can open this again from the Isotope menu (Super+Esc → Welcome)."
msgstr "Puede volver a abrir esta ventana desde el menú de Isotope (Super+Esc → Welcome)."

#: cmd/isotope-welcome/page_ready.go
#, go-format
msgid "Could not install %s."
msgstr "No se pudo instalar %s."

#: cmd/isotope-welcome/page_ready.go
#, go-format
msgid "Log out to use %s"
msgstr "Cierre la sesión para usar %s"

