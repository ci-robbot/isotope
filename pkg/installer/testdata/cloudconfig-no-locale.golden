#cloud-config
# Generated by the Isotope installer.
install:
  device: "/dev/vda"
  auto: true
  grub_options:
    extra_cmdline: "rd.vconsole.keymap=de"
  reboot: true
hostname: "box"
users:
  - name: "ada"
    gecos: "ada"
    passwd: '$6$abc$def'
    groups: [admin, audio, video, render, input, bluetooth, seat, docker]
    ssh_authorized_keys:
      - github:ada
stages:
  initramfs:
    - name: "Isotope default session"
      files:
        - path: /etc/ly/save.ini
          permissions: 0644
          content: |
            user = ada
            session_index = 2
    - name: "Isotope keyboard layout and timezone"
      files:
        - path: /etc/isotope/keyboard
          permissions: 0644
          content: |
            XKB_LAYOUT=de
            XKB_VARIANT=
        - path: /etc/X11/xorg.conf.d/00-keyboard.conf
          permissions: 0644
          content: |
            # Written by the Isotope installer.
            Section "InputClass"
                Identifier "isotope-keyboard"
                MatchIsKeyboard "on"
                Option "XkbLayout" "de"
            EndSection
      commands:
        - "ln -sfn /usr/share/zoneinfo/Europe/Berlin /etc/localtime"
        - "touch /etc/vconsole.conf && sed -i '/^KEYMAP=/d' /etc/vconsole.conf && echo 'KEYMAP=de' >> /etc/vconsole.conf"
  boot:
    - name: "Isotope display name"
      commands:
        - usermod -c ada ada
    - name: "Isotope login shell"
      commands:
        - usermod -s /bin/bash ada
