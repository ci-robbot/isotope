{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "gomod"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Europe/Rome",
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "major": {
    "dependencyDashboardApproval": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Source versions pinned as ARG FOO_VERSION=, each under a '# renovate:' comment",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Container images pinned as ARG FOO_IMAGE=<name>:<tag>, each under a '# renovate: datasource=docker' comment (GLIBC_BOX_IMAGE)",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\nARG [A-Z0-9_]+_IMAGE=\\S+:(?<currentValue>[^\\s:@]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Release candidates numbered x.y.90 and up (wayland, libinput, Xwayland)",
      "matchManagers": [
        "custom.regex"
      ],
      "allowedVersions": "!/\\.9\\d{1,2}$/"
    },
    {
      "description": "Projects whose odd minor versions are development releases",
      "matchDepNames": [
        "GNOME/glib",
        "GNOME/pango",
        "GNOME/gdk-pixbuf",
        "GNOME/json-glib",
        "GNOME/at-spi2-core",
        "GNOME/vala",
        "NetworkManager/NetworkManager",
        "gstreamer/gstreamer",
        "pipewire/pipewire",
        "cairo/cairo",
        "pixman/pixman"
      ],
      "allowedVersions": "/^\\d+\\.\\d*[02468]\\.\\d+$/"
    },
    {
      "description": "x.90 is the development series of the next major version",
      "matchDepNames": [
        "GNOME/gdk-pixbuf"
      ],
      "allowedVersions": "<2.90"
    },
    {
      "matchDepNames": [
        "GNOME/pango"
      ],
      "allowedVersions": "<1.90"
    },
    {
      "description": "GTK 3 and the C++ bindings of the GTK 3 stack: a newer series is a different API",
      "groupName": "GTK 3 stack",
      "matchDepNames": [
        "GNOME/gtk",
        "libsigcplusplus/libsigcplusplus",
        "GNOME/glibmm",
        "cairo/cairomm",
        "GNOME/pangomm",
        "GNOME/atkmm",
        "GNOME/gtkmm"
      ]
    },
    {
      "matchDepNames": [
        "GNOME/gtk",
        "GNOME/gtkmm"
      ],
      "allowedVersions": "/^3\\.24\\./"
    },
    {
      "matchDepNames": [
        "libsigcplusplus/libsigcplusplus"
      ],
      "allowedVersions": "/^2\\.\\d*[02468]\\./"
    },
    {
      "matchDepNames": [
        "GNOME/glibmm"
      ],
      "allowedVersions": "/^2\\.66\\./"
    },
    {
      "matchDepNames": [
        "cairo/cairomm"
      ],
      "allowedVersions": "/^1\\.14\\./"
    },
    {
      "matchDepNames": [
        "GNOME/pangomm"
      ],
      "allowedVersions": "/^2\\.46\\./"
    },
    {
      "matchDepNames": [
        "GNOME/atkmm"
      ],
      "allowedVersions": "/^2\\.28\\./"
    },
    {
      "description": "The SPIR-V LLVM translator must match the LLVM major",
      "groupName": "LLVM",
      "matchDepNames": [
        "llvm/llvm-project",
        "KhronosGroup/SPIRV-LLVM-Translator"
      ]
    },
    {
      "description": "Mesa numbers its releases by year (25.3 to 26.0), so each new year is a 'major' that the dependencyDashboardApproval above would hold forever. Both Mesa stages pin the same version: one PR",
      "groupName": "Mesa",
      "matchDepNames": [
        "mesa/mesa"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Other calendar-versioned projects, where a 'major' is only a new year (YYYY.N, YY.N, YY.MM)",
      "matchDepNames": [
        "ostreedev/ostree",
        "xorg/proto/xorgproto",
        "X11Libre/xserver",
        "X11Libre/xf86-input-libinput",
        "xorg/xserver",
        "YaLTeR/niri"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Mesa's meson.build refuses these bindgen releases (NVK)",
      "matchDepNames": [
        "bindgen-cli"
      ],
      "allowedVersions": "!/^0\\.(72\\.0|73\\.[01])$/"
    },
    {
      "groupName": "Vulkan SDK",
      "matchDepNames": [
        "KhronosGroup/Vulkan-Headers",
        "KhronosGroup/Vulkan-Loader",
        "KhronosGroup/glslang"
      ]
    },
    {
      "groupName": "SPIR-V",
      "matchDepNames": [
        "KhronosGroup/SPIRV-Headers",
        "KhronosGroup/SPIRV-Tools"
      ]
    },
    {
      "description": "fcitx5 and its engines (extensions/fcitx5): fcitx5-chinese-addons and libime name the fcitx5 release they need, so they move together",
      "groupName": "fcitx5",
      "matchDepNames": [
        "fcitx/fcitx5",
        "fcitx/libime",
        "fcitx/fcitx5-chinese-addons",
        "fcitx/fcitx5-anthy",
        "fcitx/fcitx5-hangul",
        "fcitx/xcb-imdkit"
      ]
    },
    {
      "description": "Each sway and cage release needs one wlroots series",
      "groupName": "sway and wlroots",
      "matchDepNames": [
        "swaywm/sway",
        "wlroots/wlroots",
        "cage-kiosk/cage"
      ]
    },
    {
      "groupName": "PipeWire",
      "matchDepNames": [
        "pipewire/pipewire",
        "pipewire/wireplumber"
      ]
    },
    {
      "groupName": "X11 libraries",
      "matchDepNames": [
        "xorg/lib/**",
        "xorg/proto/**",
        "xorg/app/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "foot",
      "matchDepNames": [
        "dnkl/tllist",
        "dnkl/fcft",
        "dnkl/foot",
        "dnkl/fuzzel"
      ]
    },
    {
      "description": "The glibc container (GLIBC_BOX_IMAGE) stays on Ubuntu LTS: only even-year .04 tags, no codenames or dated builds. The next LTS is a major and waits on the dependency dashboard",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "docker.io/library/ubuntu"
      ],
      "allowedVersions": "/^\\d*[02468]\\.04$/"
    },
    {
      "description": "libcupsfilters 2.2.0 does not build and 2.2.1 has regressions from the PDFio move; upstream points to 2.1.x until a later 2.2 release",
      "matchDepNames": [
        "OpenPrinting/libcupsfilters"
      ],
      "allowedVersions": "<2.2"
    }
  ]
}
