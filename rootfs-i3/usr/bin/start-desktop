#!/bin/sh
# XLibre/i3 session launcher used by ly. Ly owns the X server lifecycle and
# supplies DISPLAY/XAUTHORITY; this wrapper supplies the desktop environment and
# a session bus for notifications plus the PipeWire/WirePlumber user session.
[ -f /etc/i3-desktop/env ] && . /etc/i3-desktop/env
[ -f /etc/i3-desktop/env.local ] && . /etc/i3-desktop/env.local
# The system language (Welcome page), as LANG. ly sources /etc/profile only for
# sh and bash users, so read it here too.
[ -f /etc/profile.d/isotope-locale.sh ] && . /etc/profile.d/isotope-locale.sh
# Software rendering when Mesa has no working driver for the GPU. XLibre's
# modesetting driver already runs without glamor then; this gives GL clients
# (GLX through llvmpipe) and Wayland tools LIBGL_ALWAYS_SOFTWARE=1.
[ -r /usr/libexec/isotope-gpu-env ] && . /usr/libexec/isotope-gpu-env

# Flatpak apps (the first-run browser among them) fail with "Authorization
# required, but no authorization protocol specified" unless the sandbox can read
# the X cookie. Ly keeps it at $XDG_RUNTIME_DIR/lyxauth, a path the sandbox does
# not get, so pass that file in. The path is taken from the session, not
# written down, so it follows the user's id.
if [ -n "${XAUTHORITY:-}" ] && command -v flatpak >/dev/null 2>&1; then
    flatpak override --user --filesystem="$XAUTHORITY:ro" --env=XAUTHORITY="$XAUTHORITY" >/dev/null 2>&1 || true
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- i3 --config /etc/i3/config
fi
exec i3 --config /etc/i3/config
